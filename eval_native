#!/bin/sh
# Runs the full evaluation grid directly on the host JVM, without Docker.
#
# Use this when you want measurements that are not affected by the memory and
# CPU limits of the Docker VM. Note that under Docker it is the *container*
# memory limit, not only -Xmx, that decides whether a run fails with a Java
# OutOfMemoryError or is killed outright; running natively avoids that
# ambiguity.
#
# Requirements: a JDK (25 or newer) on the PATH. Maven is only needed if the
# analysis jar has not been built yet.
#
# Without arguments every example is run; otherwise only the named ones, e.g.
#   ./eval_native arbiter scrubber
#
# Environment variables:
#   HEAP      value passed to java -Xmx      (default: 42g)
#   PD        partial descendants threshold  (default: 1000)
#   JAVA_BIN  java executable                (default: java)
#   MVN       maven executable               (default: mvn)

set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

HEAP="${HEAP:-42g}"
PD="${PD:-1000}"
JAVA_BIN="${JAVA_BIN:-java}"
MVN="${MVN:-mvn}"

JAR="$SCRIPT_DIR/IfaAbstractionRefinement/target/AbstractionRefinement.jar"
CONFIG_SRC="$SCRIPT_DIR/IfaAbstractionRefinement/config"
CONFIG_DST="$SCRIPT_DIR/IfaAbstractionRefinement/target/config"
TESTDATA="$SCRIPT_DIR/IfaAbstractionRefinement/testdata"

# --- setup ---------------------------------------------------------------

if [ ! -f "$JAR" ]; then
    echo "Analysis jar not found, building it with Maven ..."
    ( cd "$SCRIPT_DIR" && "$MVN" -q clean package -DskipTests ) \
        || { echo "Build failed. Build the project manually and re-run."; exit 1; }
fi

if [ ! -f "$JAR" ]; then
    echo "Analysis jar still not found at $JAR - aborting."
    exit 1
fi

# The analysis looks for its transformer configuration in <jar directory>/config.
if [ ! -d "$CONFIG_DST" ]; then
    echo "Installing transformer configuration next to the jar ..."
    cp -r "$CONFIG_SRC" "$CONFIG_DST" \
        || { echo "Could not copy $CONFIG_SRC to $CONFIG_DST - aborting."; exit 1; }
fi

echo "============================================================"
echo "Native evaluation"
echo "Jar:   $JAR"
echo "Heap:  -Xmx$HEAP"
echo "Java:  $("$JAVA_BIN" -version 2>&1 | head -n 1)"
echo "============================================================"
echo

# --- runner --------------------------------------------------------------

run_case() {
    name="$1"
    label="$2"
    shift 2

    echo "============================================================"
    echo "Example: $name"
    echo "Case:    $label"
    echo "============================================================"

    "$JAVA_BIN" -Xmx"$HEAP" \
        -Dorg.apache.logging.log4j.simplelog.StatusLogger.level=OFF \
        -jar "$JAR" "$@" -e \
        || echo "*** case did not terminate normally (out of memory is expected for some cases) ***"

    echo
}

run_grid() {
    name="$1"

    MODEL="$TESTDATA/$name/$name.ast.xml"
    POLICY="$TESTDATA/$name/$name.policy.txt"

    # Exploration refinement only (no policy, no information flow refinement).
    run_case "$name" "without refinement, without policy" \
        -m "$MODEL"
    run_case "$name" "partial descendants threshold $PD, without policy" \
        -m "$MODEL" -d "$PD"
    run_case "$name" "splitters, without policy" \
        -m "$MODEL" -s
    run_case "$name" "splitters and partial descendants $PD, without policy" \
        -m "$MODEL" -s -d "$PD"

    # Policy checking without information flow refinement.
    run_case "$name" "with policy, without any refinement" \
        -m "$MODEL" -p "$POLICY"
    run_case "$name" "with policy, splitters, without information-flow refinement" \
        -m "$MODEL" -p "$POLICY" -s

    # Information flow refinement without exploration refinement.
    run_case "$name" "policy, cumulative IFR, without exploration refinement" \
        -m "$MODEL" -p "$POLICY" -ic
    run_case "$name" "policy, non-cumulative IFR, without exploration refinement" \
        -m "$MODEL" -p "$POLICY" -in

    # Information flow refinement combined with exploration refinement.
    run_case "$name" "splitters, policy, cumulative information-flow refinement" \
        -m "$MODEL" -p "$POLICY" -s -ic
    run_case "$name" "splitters, policy, non-cumulative information-flow refinement" \
        -m "$MODEL" -p "$POLICY" -s -in
    run_case "$name" "partial descendants $PD, policy, cumulative information-flow refinement" \
        -m "$MODEL" -p "$POLICY" -d "$PD" -ic
    run_case "$name" "splitters and partial descendants $PD, policy, cumulative information-flow refinement" \
        -m "$MODEL" -p "$POLICY" -s -d "$PD" -ic
}

# Transmitters ships its hand-written abstraction under a different name.
abstraction_for() {
    case "$1" in
        transmitters) echo "$TESTDATA/transmitters/transmitters_variables.abstraction.txt" ;;
        *)            echo "$TESTDATA/$1/$1.manual.abstraction.txt" ;;
    esac
}

run_expert_baseline() {
    name="$1"
    abstraction="$(abstraction_for "$name")"

    [ -f "$abstraction" ] || return 0

    MODEL="$TESTDATA/$name/$name.ast.xml"
    POLICY="$TESTDATA/$name/$name.policy.txt"

    run_case "$name" "expert abstraction, no automated refinement" \
        -m "$MODEL" -p "$POLICY" -a "$abstraction"
}

# --- the evaluation ------------------------------------------------------
# Cheap examples first, the two transmitter designs last.
ALL_EXAMPLES="priorities many_slots arbiter crossbar scrubber rate_adapt
              leaky_slots timing_leak transmitters leaky_transmitters"

EXAMPLES="${*:-$ALL_EXAMPLES}"

for ex in $EXAMPLES; do
    run_grid "$ex"
done

echo "############################################################"
echo "# Expert-abstraction baseline"
echo "############################################################"
echo

for ex in $EXAMPLES; do
    run_expert_baseline "$ex"
done
