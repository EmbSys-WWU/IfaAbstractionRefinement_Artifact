#!/bin/sh
set -eu

# This script runs *inside* the Docker container, e.g. via:
#   docker run --rm --name artifact artifact -c "./run_examples"

JAVA="java -Dorg.apache.logging.log4j.simplelog.StatusLogger.level=OFF -jar /app/AbstractionRefinement.jar"

run_example() {
    name="$1"

    MODEL="/app/testdata/$name/$name.ast.xml"
    POLICY="/app/testdata/$name/$name.policy.txt"

    echo "============================================================"
    echo "Running example: $name"
    echo "Model:  $MODEL"
    echo "Policy: $POLICY"
    echo "============================================================"

    $JAVA -m "$MODEL" -p "$POLICY" -s -ic

    echo
}

run_example "priorities"
run_example "many_slots"
run_example "arbiter"
run_example "transmitters"