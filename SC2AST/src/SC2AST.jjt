void ptr_to_member() :
{}
{
    scope_override()  "*"
}

void qualified_type() :
{ }
{
    LOOKAHEAD({ sym.IsFullyScopedTypeName(GetFullyScopedName()) } )
       qualified_id() {jjtThis.setIsKnown(true); }

}


void type_qualifier() :
{Token t;}
{
   (
     t = <CONST> { m_isConst = true; }
    |
     t = <VOLATILE>
   )
   {
     jjtThis.setName(t.image);
   }
}

/**
 * Very temporary. Just returns true if it sees a typedef. Finally, we will
 * need a structure that stores all the attributes.
 */
boolean storage_class_specifier() :
{Token t = null;
 boolean  isTypedef = false;}
{
   ( t = <AUTO> |  t = <REGISTER> | t = <STATIC> { m_isStatic = true; }| t = <EXTERN> | t = <TYPEDEF> { isTypedef = true; } )

   {  jjtThis.setName(t.image); return isTypedef; }
}

void builtin_type_specifier() :
{}
{
  //{m_cur_scope_in_comp_name = null;} complicated_name_spec() {m_cur_scope_in_comp_name = null;})
  
  [ namespace_name() <SCOPE> ] systemCTypes(jjtThis) 
  
    
  |
    c_built_inTypes(jjtThis)
   
   
}


void init_declarator_list(boolean isTypedef) #void :
{}
{
   init_declarator(isTypedef) ("," init_declarator(isTypedef))*
}

void init_declarator(boolean isTypedef) :
{ String name; }
{
   name = declarator()
   {

      if (isTypedef)
         sym.PutTypeName(name);

   }
   (
    "=" initializer()
   |
    pl() expression_list()  pr()
   )?
}

void class_head() :
{ }
{
   (
    ("struct" | "union" | "class")
    (getID() (base_clause(null))?)?
   )
  |
   (
    ( (<SC_MODULE_MACRO> | <SC_PROTOCOL_MACRO>) pl() getID() pr() ) (base_clause(null))?
   )
}

void class_specifier() :
{
   ClassScope sc = null;

   Token t;
   m_isExtOfSCClass = false;
   String base_class;

}
{
   (
     ( <SC_MODULE_MACRO> {base_class = SC_MODULE_CONST; }
      |
       <SC_PROTOCOL_MACRO> {base_class = SC_PROTOCOL_CONST; }
     )

     pl() t = getID() pr()

     {
        sc = (ClassScope)sym.OpenScope(t.image, true);
        jjtThis.setName(t.image);
        jjtThis.setKeyword("class");
        // *******************************************************************************
        // creates some additional nodes to present correct AST tree for SC_MODULE_MACRO macro
        // *******************************************************************************

        ASTbase_clause b_c = new ASTbase_clause(null, JJTBASE_CLAUSE);
        jjtree.openNodeScope(b_c);

          ASTbase_specifier b_cp = new ASTbase_specifier(null, JJTBASE_SPECIFIER);
          jjtree.openNodeScope(b_cp);

          b_cp.setName(base_class);
          b_cp.setSystemCDataType(true);

            ASTbase_class_access_specifier b_access_sp = new ASTbase_class_access_specifier(null, JJTBASE_CLASS_ACCESS_SPECIFIER);
            jjtree.openNodeScope(b_access_sp);
            b_access_sp.setName("public");

            jjtree.closeNodeScope(b_access_sp, true);

          jjtree.closeNodeScope(b_cp, true);

        jjtree.closeNodeScope(b_c, true);

        // adds "public" access specifiers

        ASTmember_declaration m_d = new ASTmember_declaration(null, JJTMEMBER_DECLARATION);
        jjtree.openNodeScope(m_d);

          ASTaccess_specifier a_sp = new ASTaccess_specifier(null, JJTACCESS_SPECIFIER);
          jjtree.openNodeScope(a_sp);

          a_sp.setName("public");

          jjtree.closeNodeScope(a_sp, true);

        jjtree.closeNodeScope(m_d, true);


        jjtThis.setExtOfSCClass(true);



     }

     (base_clause(sc))?

     // class body

     "{" class_body(jjtThis.name()) "}"
     {
        sym.CloseScope();
     }

   )
  |
   (
     ("struct" { jjtThis.setKeyword("struct"); } | "union" { jjtThis.setKeyword("union"); } | "class" { jjtThis.setKeyword("class"); } )
     (
      "{"
          {
             sym.OpenScope(null, false);
          }
          class_body(jjtThis.name())
      "}"
          {
             sym.CloseScope();
          }
     |
      LOOKAHEAD(2) t = getID()
       {
          sc = (ClassScope)sym.OpenScope(t.image, true);
        // eingefuegt
        jjtThis.setName(t.image);
       }
       (base_clause(sc))?

       // class body

      "{"
         class_body(jjtThis.name())
         {
           if (m_isExtOfSCClass) {
             jjtThis.setExtOfSCClass(true);
           }
         }

      "}"
          {
             sym.CloseScope();
          }
     |
      t=getID() (LOOKAHEAD(2) "<" template_argument_list()  ">")?
      {
        sym.PutTypeName(t.image);
        jjtThis.setName(t.image);
        if (m_isExtOfSCClass) {
          jjtThis.setExtOfSCClass(true);
        }
      }
     )
   )
}

void base_clause(ClassScope scope) :
{ boolean val = m_isExtOfSCClass; }
{
  (
   ":" base_specifier(scope) { if (val != true) val = m_isExtOfSCClass; }( "," base_specifier(scope) { if (val != true) val = m_isExtOfSCClass; })*
  ) 

   {
     if (val != m_isExtOfSCClass) {
       m_isExtOfSCClass = val;
     }

   }
}


void base_class_access_specifier() :
{Token t = null; String res = "private", res2;}
{
   (
     t = <VIRTUAL> { res = t.image; }
     (res2 =  base_class_access_specifier_helper() { res = res + " " + res2; } )?
    |
     res = base_class_access_specifier_helper()
     (t = <VIRTUAL> { res = res + " " + t.image; } )?
   )?
   { jjtThis.setName(res); }
}


void base_specifier(ClassScope scope) :
{ Token t; boolean isSCType = false;}
{
//("virtual" (LOOKAHEAD(2)access_specifier())? | access_specifier() (LOOKAHEAD(2)"virtual")?)?
   base_class_access_specifier()
   (LOOKAHEAD(scope_override_lookahead()) scope_override())?

   (t = systemCTypes(jjtThis)  {isSCType = true;} |  t= getID() )
   ("<" template_argument_list()  ">")?
   {
      jjtThis.setName(t.image);
      jjtThis.setSystemCDataType(isSCType);
      m_isExtOfSCClass = isSCBaseClass(t);


      scope.AddSuper(sym.GetScope(t.image));
   }
}

void access_specifier() :
{Token t = null;}
{
    t = <PUBLIC> { jjtThis.setName(t.image); }
   |
    t = <PROTECTED> { jjtThis.setName(t.image); }
   |
    t = <PRIVATE> { jjtThis.setName(t.image); }

}

String base_class_access_specifier_helper() #void :
{Token t;}

{
    t = <PUBLIC> { return t.image; }
   |
    t = <PROTECTED> { return t.image; }
   |
    t = <PRIVATE> { return t.image; }

}

void bit_field_member_declaration() :
{String declaratorStr = null; }
{
  type_specifier() ( declaratorStr = declarator()  )? <COLON> constant_expression() <SEMICOLON>
  (
     { 
        if ( declaratorStr == null )
	  jjtThis.setIsNamed( false );
	else
	  jjtThis.setIsNamed( true );
     }
  )
	
}

void member_declaration(String class_name)  :
{ boolean isTypedef = false;
  m_isStatic = m_isConst = m_isCBuiltInType = false;

}
{
  (
    LOOKAHEAD(bit_field_member_declaration())
      bit_field_member_declaration()
   |
    LOOKAHEAD( port_specifier_helper() )
      ( port_specifier_helper() (member_declarator_list(false))? ";") #member_declarator_list
   |

   /* new added to suport template classe declarations inside class */
   
    LOOKAHEAD(("typedef" | template_head())? class_head()  "{")
       ( template_head() )? declaration()
   |       
    LOOKAHEAD(("typedef")? class_head() "{") declaration()

   |
    LOOKAHEAD("enum" (getID())? "{") enum_specifier()
       ( member_declarator_list(false) )?  ";"
   |
    LOOKAHEAD( "operator" )
       conversion_function_decl_or_def()
   |
    LOOKAHEAD(dtor_ctor_decl_spec() dtor_declarator() "{")
       dtor_definition()
   |
    LOOKAHEAD(("inline"| "virtual" | <EXPLICIT>)* "~")
       dtor_ctor_decl_spec() simple_dtor_declarator()  ";"
   |
    LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
      ctor_definition()
   |
    LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead() ";")
      (dtor_ctor_decl_spec() ctor_declarator() ";")
   |
    LOOKAHEAD((declaration_specifiers())? function_declarator_lookahead())
       function_definition()

   |
    LOOKAHEAD(declaration_specifiers())
       (isTypedef = declaration_specifiers()
          (member_declarator_list(isTypedef))? ";") #member_declarator_list
   |

    LOOKAHEAD(getID()) function_declarator(false) ";"
   |
    LOOKAHEAD(3)
     qualified_id() ";"
   |
    access_specifier()  ":"
   |
    ";"
   
//   |
//    export_declaration() ";"
   |
    sc_has_process_declaration() ";"
   |
    sc_map_to_target_declaration() [ LOOKAHEAD(2) ";"]
  )  

  {
    m_isStatic = m_isConst = m_isCBuiltInType = false;
  }
}


void member_declarator_list(boolean isTypedef) #void :
{}
{
   member_declarator(isTypedef) // ("=" <OCTALINT>)?
   ("," member_declarator(isTypedef) /*("=" <OCTALINT>)?*/)*

}

void member_declarator(boolean isTypedef) :
{ String name; }
{
   name = declarator()
   {
      if (isTypedef)
         sym.PutTypeName(name);
   }
   
   (LOOKAHEAD({isAllowMemberInitialization()})
    (
       "=" initializer()
      |
       pl() expression_list()  pr()
    )   
   )?
   
}

void conversion_function_decl_or_def() :
{
}
{
   [ LOOKAHEAD(scope_override_lookahead()) scope_override() ]

   "operator" declaration_specifiers() ("*" | "&")?

   pl() (parameter_list())? pr()
   (LOOKAHEAD(2) type_qualifier())?
   (exception_spec())?
   func_decl_def(null)  // Temporary (fix the null)
}

void enum_specifier() :
{ Token t; }
{
   "enum"

   (
    "{" enumerator_list() "}"
   |
    t=getID() (LOOKAHEAD(2) "{" enumerator_list() "}")?
           { sym.PutTypeName(t.image); jjtThis.setName(t.image); }
   )
}

void enumerator_list() :
{}
{
   enumerator() ("," enumerator())*
}

void enumerator() :
{ Token t; }
{
   t = getID() ("=" constant_expression())? {jjtThis.setName(t.image); }
}

void ptr_operator() :
{}
{
    "&" { jjtThis.setName("&"); } cv_qualifier_seq()
   |
    "*" { jjtThis.setName("*"); } cv_qualifier_seq()
   |
    ptr_to_member() cv_qualifier_seq()
}
/*
 * #void eingefuegt

 */
void cv_qualifier_seq() #void :
{}
{
   [ LOOKAHEAD(2) (
     "const" [ LOOKAHEAD(2) "volatile" ]
    |
     "volatile" [ LOOKAHEAD(2) "const" ] ) #cv_qualifier
   ]
}

String declarator() :
{ String name; }
{

  (
    LOOKAHEAD(ptr_operator())
      ptr_operator() name = declarator()
   |
    name = direct_declarator()
  )

  { return name; }
}
/*
 * #void eingefuegt
 */
String direct_declarator()  #void  :
{
   String name;
   Token t;
}
{
   LOOKAHEAD(2)
    "~" t = getID() (LOOKAHEAD(2) declarator_suffixes())?
        { return "~" + t.image; }
   |
    pl() name = declarator() pr() (LOOKAHEAD(2) declarator_suffixes())?
        { return name; }
   |
    name = qualified_id() (LOOKAHEAD(2) declarator_suffixes())?

    { return name; }
}

void declarator_suffixes() :
{}
{
    ("[" (constant_expression())? "]" { jjtThis.arrayCounter++; } )+
   |
    pl() (parameter_list())? pr()
    (LOOKAHEAD(2) type_qualifier())?
    (exception_spec())?
}

/**
 * Used only for lookahead.
 */
void function_declarator_lookahead() :
{}
{
   (LOOKAHEAD(2) ptr_operator() )* qualified_id() pl()
}

Scope function_declarator(boolean isTypedef) :
{ Scope sc = null; }

{
  (
    LOOKAHEAD(ptr_operator())
       ptr_operator() sc = function_declarator(isTypedef)
   |
     sc = function_direct_declarator(isTypedef)
  )

  { return sc; }
}

/* veraendert
 * #void eingefuegt

 */
Scope function_direct_declarator(boolean isTypedef) #void :
{
  String name;
  Scope sc = null;
  boolean closeReqd = false;
}
{
     name = qualified_id()


     {
        sc = sym.GetScopeOfFullyScopedName(name);

        if (closeReqd = (sc != null && sc != sym.GetCurScope()))
           sym.SetCurrentScope(sc);
     }

     pl() (parameter_list())?  pr()
     (LOOKAHEAD(2) type_qualifier())?
     (exception_spec())?
     (LOOKAHEAD("=") "=" <OCTALINT>)?

     {
        if (closeReqd)

           sym.CloseScope();

        if (isTypedef)
           sym.PutTypeName(name);

        return sc;
     }
}

/*
 * #void eingefuegt
 */
void dtor_ctor_decl_spec() #void :
{}
{

   [
    dtor_ctor_decl_spec_helper1() [dtor_ctor_decl_spec_helper2()] [dtor_ctor_decl_spec_helper3()]
   |
    dtor_ctor_decl_spec_helper2() [dtor_ctor_decl_spec_helper1()] [dtor_ctor_decl_spec_helper3()]
   | 
    dtor_ctor_decl_spec_helper3() [dtor_ctor_decl_spec_helper1()] [dtor_ctor_decl_spec_helper2()]
   ]
}


void dtor_ctor_decl_spec_helper1() #dtor_ctor_decl_spec :
{Token t = null;}
{
  t = <VIRTUAL> { jjtThis.setName(t.image); }
}

void dtor_ctor_decl_spec_helper2() #dtor_ctor_decl_spec :
{Token t = null;}
{
  t = <INLINE> { jjtThis.setName(t.image); }
}

void dtor_ctor_decl_spec_helper3() #dtor_ctor_decl_spec :
{Token t = null;}
{

  t = <EXPLICIT> { jjtThis.setName(t.image); }
}
    


void dtor_definition() :
{}
{
   (template_head())?
   dtor_ctor_decl_spec()
   dtor_declarator()
   compound_statement()
}

void local_watching_block() :
{}
{
  <W_BEGIN>
    [sc_watching_list()] #begin_block
  <W_DO>
    (LOOKAHEAD(statement()) statement())* #do_block
  <W_ESCAPE>
    (LOOKAHEAD(statement()) statement())* #escape_block
  <W_END>
}

void ctor_definition() :
{
   Scope sc = null;
   boolean closeReqd = false;
   boolean isInit = false;
}
{
   dtor_ctor_decl_spec()
   sc = ctor_declarator()


   {
      if (closeReqd = (sc != null && sc != sym.GetCurScope()))
         sym.SetCurrentScope(sc);
   }



   (exception_spec())?

   (
     ";"
    |
     [ ctor_initializer() {isInit = true;} ]
       {
         if (m_isCTOR && isInit == false) {

           //***********************************
           // adds initialisation of _name
           //***********************************

           ASTctor_initializer ct_init = new ASTctor_initializer(null, JJTCTOR_INITIALIZER);

           jjtree.openNodeScope(ct_init);

           addSuperClassInitNode();


           jjtree.closeNodeScope(ct_init, true);


         }
       }



     (
     "{"

       { sym.OpenScope(null, false); }

       (
            LOOKAHEAD(3) (sc_method() [LOOKAHEAD(2)";"] ( LOOKAHEAD(2) method_thread_fol_decl() )? )  #sc_method_block
          |
            LOOKAHEAD(3) (sc_thread() [LOOKAHEAD(2)";"] ( LOOKAHEAD(2) method_thread_fol_decl() )? )  #sc_thread_block
          |
            LOOKAHEAD(3) (sc_cthread() [LOOKAHEAD(2)";"] (LOOKAHEAD(sc_watching_list()) sc_watching_list())?)  #sc_cthread_block
          |
            LOOKAHEAD(3) sc_slave() [LOOKAHEAD(2)";"]
          |
          LOOKAHEAD(statement())
            statement()


       )*

       { sym.CloseScope(); }

     "}"
     )

     #block

   )

   { if (closeReqd) sym.CloseScope(); }
}

String ctor_declarator_lookahead() :
{}
{

   LOOKAHEAD(  { IsCtor() } ) ( <SC_CTOR> pl() qualified_id() )  | (qualified_id() pl() )

}
/*
 * #void eingefuegt

 */


Scope ctor_declarator()  #void :
{
  String name;
  Scope sc = null;
  boolean closeReqd = false;
}
{


    LOOKAHEAD( { IsCtor() } )
     (
       (
         name = qualified_id()

          {
             m_isCTOR = false;

             sc = sym.GetScopeOfFullyScopedName(name);

             if (closeReqd = (sc != null && sc != sym.GetCurScope()))
                sym.SetCurrentScope(sc);
          }
         pl() [ LOOKAHEAD(2) parameter_list() ]  pr()


         [ LOOKAHEAD(2) exception_spec() ]
       )


      |

        <SC_CTOR>  pl() name = qualified_id() pr()

         {
            m_isCTOR = true;

            m_isExtOfSCClass = true;


            // ********************************************
            // generates code instead macro SC_CTOR
            // ********************************************

            addCTORInstruction();



            sc = sym.GetScopeOfFullyScopedName(name);

            if (closeReqd = (sc != null && sc != sym.GetCurScope()))
               sym.SetCurrentScope(sc);
         }

     )


     {
        if (closeReqd)
           sym.CloseScope();

        return sc;
     }
}

void ctor_initializer() :
{
  boolean isInit = false;

}
{
   ":" superclass_init()
     {
       if (m_isCTOR && isInit == false) {

         //***********************************
         // adds initialisation of _name
         //***********************************

         addSuperClassInitNode();


         isInit = true;
       }


     }
   ("," superclass_init())*

}

void superclass_init() :
{}
{

   (LOOKAHEAD(3) qualified_id() | LOOKAHEAD([namespace_name() <SCOPE>] systemCTypes(jjtThis)) declaration_specifiers() )  pl() (expression_list())?  pr()



}
void dtor_declarator()  :
{}
{
   (LOOKAHEAD(scope_override_lookahead()) scope_override())?
    simple_dtor_declarator()

}

void simple_dtor_declarator() :
{}
{
   "~"
   LOOKAHEAD( { IsCtor() } ) getID() pl() (parameter_list())?  pr()
}

void parameter_list() :
{ }
{

    parameter_declaration_list() [ LOOKAHEAD(2) [ "," ]  ellipsis_parameter()]
   |
    ellipsis_parameter()


}

void ellipsis_parameter() :
{}
{
  "..."  
}

/* veraendert
 * #void eingefuegt
 */
void parameter_declaration_list() #void :
{}
{
   parameter_declaration() (LOOKAHEAD(2) "," parameter_declaration())*
}

void parameter_declaration() :
{}

{
   declaration_specifiers()
   (
    LOOKAHEAD(declarator()) declarator()
   |
    abstract_declarator()
   )
   ("=" assignment_expression())?
}

void declaration_specifiers_with_declarator() #void :
{}
{
   declaration_specifiers()
   [ptr_operator()]

   
}

/*
 * veraendert #array_initializer eingef\FCgt
 */
void initializer() :

{}
{
    LOOKAHEAD(5)
     ("{" initializer() (LOOKAHEAD("," initializer()) ("," initializer()) )* [","] "}" ) #array_initializer


   |
    assignment_expression()

}

void type_name() :
{}
{


  declaration_specifiers() abstract_declarator()
}

void abstract_declarator() :
{}
{
   [ LOOKAHEAD(2) (
    pl() abstract_declarator()   pr()
    (abstract_declarator_suffix())+
   |
    ("[" (constant_expression())? "]")+
   |
    ptr_operator() abstract_declarator() )
   ]
}

void abstract_declarator_suffix() :
{}
{
    "[" ( constant_expression() )?  "]"
   |
    pl() (parameter_list())? pr()
}

void template_head() :
{}
{
   "template" "<" template_parameter_list() ">"
}

void template_parameter_list() :
{}
{
   template_parameter() ("," template_parameter())*
}

void template_parameter() :
{ Token t; }

{
    LOOKAHEAD(3)
      ("class" | "typename") t=getID() {   jjtThis.setName(t.image); sym.PutTypeName(t.image); }

   |
    parameter_declaration()

}

void template_id() :
{}
{
   getID() "<" template_argument_list() ">"
}

void template_argument_list() :
{}
{
   template_argument() ("," template_argument())*
}

void template_argument() :
{}
{
    LOOKAHEAD(3)
      type_name()
   |
    shift_expression()
}

void statement_list() #void:

{}
{
   (LOOKAHEAD(statement()) statement())+
}



void statement() #block_statement :

{}
{

   LOOKAHEAD(4) sc_map_to_target() [LOOKAHEAD(2) ";"]
   |
   LOOKAHEAD([namespace_name() <SCOPE>] (<COUT> | <CERR>))  ([namespace_name() <SCOPE>] output_stream() )  
    
   |
    LOOKAHEAD(declaration())
      declaration()
   |
   LOOKAHEAD( expression() ";" )
      expression() ";"
   |
    compound_statement()
   |
    selection_statement()
   |
    jump_statement()
   |
    ";"  #empty_statement
   |
    try_block()
   |
    throw_statement()
   |
    LOOKAHEAD(2)
      labeled_statement()
   |
     iteration_statement()
   |

     sc_notify() ";"
   |
    local_watching_block()
   |
    dyn_process_creation_block_declaration()
   |
    sc_report_macro()
//   |
//    (report_handler_scope() postfix_expression_helper()) #postfix_expression(>1) ";"
   |
    fzi_sim_directive()

}


void rstatement() #block_statement :
{}
{



    LOOKAHEAD(4)
      sc_map_to_target() [ LOOKAHEAD(2) ";"]
   |
   LOOKAHEAD([namespace_name() <SCOPE>](<COUT> | <CERR>))
    output_stream()

   |
    LOOKAHEAD( declaration() )
      declaration()
   |

    LOOKAHEAD( expression() ";" )
      expression() ";"
   |
    selection_statement()
   |
    jump_statement()
   |
    ";"  #empty_statement
   |
    try_block()
   |
    throw_statement()
   |
    LOOKAHEAD(2)
      labeled_statement()
   |
     iteration_statement()
   |
     sc_notify() ";"
   |
    local_watching_block()

   |
    dyn_process_creation_block_declaration()
   |
    sc_report_macro()
//   |
//    (report_handler_scope() postfix_expression_helper()) #postfix_expression(>1) ";"
   |
    fzi_sim_directive()


}

void labeled_statement() :
{}
{
    getID() ":" statement()


 /*  |
    "case" constant_expression()  ":" statement()
   |
    "default"  ":" statement() */
}

void compound_statement() #block :
{}
{
   "{"

   { sym.OpenScope(null, false); }

   (statement_list())?


   { sym.CloseScope(); }

   "}"
}

/* hinzugefuegt */
void cf_block() #void:
{}
{
  compound_statement()
 |
  rstatement() #block(1)
}

/* veraendert */

void selection_statement() #void :
{}
{

    ( "if" pl() expression() pr() cf_block()
     (LOOKAHEAD(2) "else" cf_block())? ) #if_statement
   |
    ( "switch" pl() expression() pr() "{" (switch_label()  (statement())* )* "}" ) #switch_statement
}

void switch_label() :
{}
{
   "case" constant_expression() ":"
  |
   "default"  ":"
}

void iteration_statement() #void :
{}
{
    ("while" pl() expression() pr() cf_block() ) #while_statement
   |
    ("do" cf_block()  "while" pl() expression() pr() ";") #do_statement
   |

 /*  ("for" pl() (LOOKAHEAD(3) declaration() | expression() ";" | ";")
    (expression())? ";" (expression())? pr() statement()) #for_statement */


     ("for"  pl() ( (LOOKAHEAD(3) declaration() | expression() ";" | ";") #for_init(>0) )
     (((expression())? ";") #for_condition(>0))  (((expression())? #statement_expression_list(>0)) #for_update(>0))  pr()
     ( cf_block()   #for_block))  #for_statement
}



void jump_statement() #void :
{}

{
    ( "goto" getID() ";" ) #goto_statement
   |
    ( "continue" ";" ) #continue_statement
   |
    ( "break" ";" ) #break_statement
   |
    ( "return" (expression())? ";" ) #return_statement
}

void try_block() :
{}
{
   "try" compound_statement() (handler())*
}


void handler() :
{}
{
   "catch" pl() exception_declaration() pr()
   compound_statement()
 |
   "finally" compound_statement()
}


void exception_declaration() :
{}
{    parameter_declaration_list()
   |
     "..."
}

void throw_statement() :
{}

{    "throw" (assignment_expression())? ";"
}

/*
 * veraendert
 */
void expression()  #void :
{}
{    
     assignment_expression()
     (
        LOOKAHEAD(2)
          "," assignment_expression()
     )*
    

}


/*
 * veraendert: assignment_expression entspricht expression in J2VHDL
 */
void assignment_expression() #void :
{}
{
    conditional_expression() 
    ( assignment_operator() assignment_expression() #assignment(3)
      | assignment_expression_operator() assignment_expression() #expression_assignment(3)
   )?
}


/*
 * neu hinzugefuegt
 */

void assignment_operator() :
{}
{
  "="
}


/*
 * neu hinzugefuegt
 */

void assignment_expression_operator() :
{ Token t; }
{
 (
  t = <TIMESEQUAL>

  |
   t = <DIVIDEEQUAL>
  |
   t = <MODEQUAL>
  |
   t = <PLUSEQUAL>
  |
   t = <MINUSEQUAL>
  |
   t = <BITWISEANDEQUAL>
  |
   t = <BITWISEXOREQUAL>
  |
   t = <BITWISEOREQUAL>
  |
   t = <SHIFTLEFTEQUAL>
  |
   t = <SHIFTRIGHTEQUAL>
 )

 { jjtThis.setName(t.image); }

}

///*
// * neu hinzugefuegt
//*/
//void conditional_expression() #void :
//{}
//{   logical_or_expression()
//("?" conditional_expression()  ":" conditional_expression() #questionmark_expression(2))?
//}
//

void conditional_expression() #void:
{
  
  
}
{   LOOKAHEAD(logical_or_expression()

             "?"  conditional_expression()  ":" conditional_expression()  ) 
   (
    (logical_or_expression()

    "?" conditional_expression()  ":" conditional_expression())  #questionmark_expression
   ) 
   |
    logical_or_expression()
  
}

void constant_expression()  :
{}
{    conditional_expression() //#questionmark_expression(3)
}


/*
 * neu hinzugefuegt
 */

void logical_or_expression() #void :
{}
{    logical_and_expression() ( "||" logical_and_expression() #or_node(2) )*

}

/*
 * neu hinzugefuegt
 */

void logical_and_expression()  #void :
{}
{    inclusive_or_expression() ( "&&" inclusive_or_expression() #and_node(2) )*
}

/*
 * neu hinzugefuegt
 */
void inclusive_or_expression() #void :
{}
{    exclusive_or_expression()( "|" exclusive_or_expression() #bitwise_or_node(2) )*
}

/*
 * neu hinzugefuegt
 */
void exclusive_or_expression() #void :
{}
{    and_expression()( "^" and_expression() #bitwise_xor_node(2) )*
}

/*
 * neu hinzugefuegt
 */
void and_expression() #void :

{}
{    equality_expression()( LOOKAHEAD(2) "&" equality_expression() #bitwise_and_node(2) )*
}

/*
 * neu hinzugefuegt
 */
void equality_expression() #void :
{}
{    relational_expression()
	(
           "!=" relational_expression() #neq_node(2)
         |
	   "==" relational_expression() #eq_node(2)
        )*
}

/*
 * neu hinzugefuegt
 */
void relational_expression() #void :
{}
{
   shift_expression()
   (
        LOOKAHEAD(2)
        (
         "<"  shift_expression()  #lt_node(2)
         |
	 ">"  shift_expression()  #gt_node(2)
         |
	 "<=" shift_expression()  #le_node(2)
         |
         ">=" shift_expression()  #ge_node(2)
        )
   )*
}

/*
 * neu hinzugefuegt
 */

void shift_expression() #void :
{
}
{
     additive_expression()
     (
      LOOKAHEAD("<<",{!(m_isStream_output && m_isBal)}) (

      "<<" additive_expression() #left_shift_node(2) )
        {
             m_isBal = true;
        }
      |
        ">>" additive_expression() #right_shift_node(2)
     )*
}




void additive_expression() #void :
{}

/* sc_concatenation_node  (a,b) oder ((a,b),c)  */
{
    multiplicative_expression()

    (
      LOOKAHEAD(2)
      (
        "+" multiplicative_expression() #add_node(2)
      |
        "-" multiplicative_expression() #subtract_node(2)
      )
    )*


}





void multiplicative_expression() #void :
{}
{  pm_expression()
   (
     LOOKAHEAD(2)
     (

      "*" pm_expression()  #mul_node(2)

     |

      "/" pm_expression()  #div_node(2)
     |
      "%" pm_expression()  #mod_node(2)
     )
   )*
}

/*
 * neu hinzugefuegt
 */
void pm_expression()  #void :
{}
{
    cast_expression()
    (
       ".*"   cast_expression() #pm_expression(2)
     |
       "->*"  cast_expression() #pm_expression(2)
    )*
}

/*
 * neu hinzugefuegt
 */
void cast_expression() #void :
{}
{   
   LOOKAHEAD(pl() type_name() pr())    
    (pl() type_name() pr() cast_expression()) #cast_expression(2)
   |

   LOOKAHEAD(unary_expression())
     unary_expression()

}
/*
 *
 */
void unary_expression() #void :
{}
{
     "++" unary_expression() #preincrement_node(1)
   |

     "--" unary_expression() #predecrement_node(1)
   |
     LOOKAHEAD(3)
     (unary_operator() cast_expression()) #unary_expression
   |
     "sizeof"
     (
       LOOKAHEAD(pl())
       pl() type_name()  pr()
     |
       unary_expression()
     ) #sizeof_expression(1)

   |
//   LOOKAHEAD(report_handler_scope())
//    (report_handler_scope() ";")
//   |
   LOOKAHEAD(3)
   ((sc_function_in_statement() postfix_expression_helper()) #postfix_expression(>1))
   |
     postfix_expression()   #postfix_expression(>1)
}

void new_expression() :
{}
{
   (LOOKAHEAD("::") ("::"))?
   "new"
   (
     LOOKAHEAD(pl() type_name() pr() )

      pl() type_name() pr()
    |
     (LOOKAHEAD(pl() expression_list() ) pl() expression_list() pr())?
     (
       LOOKAHEAD(pl() type_name() pr() )
       pl() type_name() pr()

      |
       LOOKAHEAD(declaration_specifiers())
        new_type_id()
     )
   )
   (LOOKAHEAD(new_initializer()) new_initializer())?
}

void new_type_id() :
{}
{
   declaration_specifiers()
   ( LOOKAHEAD(new_declarator()) new_declarator() )?
}

void new_declarator() :
{}
{
     direct_new_declarator()
   |
     ptr_operator() cv_qualifier_seq()  [ LOOKAHEAD(2) new_declarator() ]
}

void direct_new_declarator() :
{}
{
   (LOOKAHEAD(2) "[" expression() "]" )+
}

void new_initializer() :
{}
{    pl() ( expression_list() )? pr()
}

void delete_expression() :
{}
{    ( "::" )? "delete" cast_expression()
}

void delete_array_expression() :
{}
{    ( "::" )? "delete" "[" "]" cast_expression()
}

void unary_operator() :
{}
{    "&"  {jjtThis.setOperator("ref");}
   | "*"  {jjtThis.setOperator("pointer");}
   | "+"  {jjtThis.setOperator("add");}
   | "-"  {jjtThis.setOperator("minnus");}
   | "~"  {jjtThis.setOperator("tilde");}
   | "!"  {jjtThis.setOperator("not");}
}

/*
 * neu hinzugefuegt

 */


//void postfix_expression()  #void:
//{}
//
//{
//   LOOKAHEAD(3)
//    primary_expression()
//    ( LOOKAHEAD(2) (
//     "[" expression() #arrayaccess_expression "]" #primary_expression(>1)

//    |
//     ( pl() ( expression_list() )? pr()) #arguments
//    | LOOKAHEAD(2)
//     "." id_expression(false)
//    |
//     "->" id_expression(false)
//    |
//     "++" #postincrement_node(1)
//    |
//     "--" #postdecrement_node(1))

//
//    )*
//  |
//   simple_type_specifier() pl() ( expression_list() )? pr()
//}
void expr_list() #void :
{}
{
  ( pl() ( expression_list() )? pr()) #arguments
}


void dereferencing_operator() :
{}
{
    "." { jjtThis.setName("&"); }
   |
    "->" { jjtThis.setName("*"); }
}

void postfix_expression_helper() #void:
{}
{
    
   (
    LOOKAHEAD(2) (

    "[" expression() #arrayaccess_expression(2) "]" #primary_expression(1)
    |
     ( pl() ( expression_list() )? pr()) #arguments
    | 
     LOOKAHEAD(2) 
     dereferencing_operator() id_expression(false)
    |
     dereferencing_operator() id_expression(false)
    |
     "++" #postincrement_node(1)
    |
     "--" #postdecrement_node(1))
   )*  
}


/*
 * neu hinzugefuegt
 */
void postfix_expression()  #void:
{}
{
   LOOKAHEAD(3)
    primary_expression()
    postfix_expression_helper()
//    ( LOOKAHEAD(2) (
//     "[" expression() #arrayaccess_expression(2) "]" #primary_expression(1)
//    |
//     ( pl() ( expression_list() )? pr()) #arguments
//    |
//      postfix_expression_helper())
//    )*
  |
   simple_type_specifier() pl() ( expression_list() )? pr()
}


void sc_function_in_sc_main() #systemCRoutine :
{Token t = null; String name = null;}
{
  (
   (
    (
      t = <SC_CYCLE>
     |
      t = <SC_ASSERT>
     |
      t = <SC_START>
     |
      t = <SC_SET_TIME_RESOLUTION>

     |
      t = <SC_SET_DEFAULT_TIME_UNIT>
     |
      t = <SC_TRACE>
     |
      t = <SC_CREATE_VCD_TRACE_FILE>
     |
      t = <SC_CREATE_WIF_TRACE_FILE>
     |

      t = <SC_CREATE_ISDB_TRACE_FILE>
     |
      t = <SC_CLOSE_WIF_TRACE_FILE>
     |
      t = <SC_CLOSE_ISDB_TRACE_FILE>
     |
      t = <SC_CLOSE_VCD_TRACE_FILE>
     |
      t = <SC_BIND_ROUTINE>
     |
      t = <SC_REF_ROUTINE>
     |
      t = <SC_CREF_ROUTINE>
     |
      t = <SC_SET_STOP_MODE_ROUTINE>
     |
      t = <SC_GEN_UNIQUE_NAME_ROUTINE>
     |
      t = <SC_ABS_ROUTINE>
     |
      t = <SC_MAX_ROUTINE>
     |
      t = <SC_MIN_ROUTINE>
     |
      t = <SC_STOP_HERE_ROUTINE>                       
    )
    expr_list()
   )

   |

   (
    (
      t = <SC_INITIALIZE>
     |
      t = <SC_STOP>
     |
      t = <SC_GET_TIME_RESOLUTION>
     |
      t = <SC_GET_DEFAULT_TIME_UNIT>
     |
      t = <SC_TIME_STAMP>
     |
      t = <SC_START_OF_SIMULATION_INVOKED_ROUTINE>
     |
      t = <SC_END_OF_SIMULATION_INVOKED_ROUTINE>
     |
      t = <SC_SIMULATION_TIME_ROUTINE>

     |
      t = <SC_GET_CURR_PROCESS_HANDLE_ROUTINE>
     |
      t = <SC_GET_CURR_SIMCONTEXT_ROUTINE>
     |
      t = <SC_GET_LAST_CREATED_PROCESS_HANDLE_ROUTINE>
     |
      t = <SC_GET_CURR_PROCESS_KIND_ROUTINE>
     |
      t = <SC_COPYRIGHT_ROUTINE> 
     |
      t = <SC_VERSION_ROUTINE>

    )
    pl() pr()  #arguments
   )

   |
    LOOKAHEAD(3)
    t = sc_spawn_routine()
   |
    name = report_handler_scope()      
  )
   {
     if (name != null)
       jjtThis.setName(name);
     else
       jjtThis.setName(t.image);
   }
}

void sc_function_in_statement() #systemCRoutine :
{Token t = null; String name = null;  }
{

  (
   (
    (

      t = <SC_STOP>
     |
      t = <SC_GET_TIME_RESOLUTION>
     |
      t = <SC_GET_DEFAULT_TIME_UNIT>
     |
      t = <SC_TIME_STAMP>
     |
      t = <SC_ARGC_ROUTINE>
     |
      t = <SC_ARGV_ROUTINE>
     |
      t = <SC_START_OF_SIMULATION_INVOKED_ROUTINE>
     |

      t = <SC_END_OF_SIMULATION_INVOKED_ROUTINE>
     |
      t = <SC_SIMULATION_TIME_ROUTINE>
     |
      t = <SC_GET_CURR_PROCESS_HANDLE_ROUTINE>
     |
      t = <SC_GET_CURR_SIMCONTEXT_ROUTINE>
     |
      t = <SC_GET_LAST_CREATED_PROCESS_HANDLE_ROUTINE>
     |
      t = <SC_GET_CURR_PROCESS_KIND_ROUTINE>
     |
      t = <SC_COPYRIGHT_ROUTINE>
     |
      t = <SC_VERSION_ROUTINE>
     |

      t = <SC_STOP_HERE_ROUTINE>                             

    )
    pl() pr()  #arguments
   )

   |

   (
    (
      t = <SC_ASSERT>
     |
      t = <SC_SET_TIME_RESOLUTION>
     |
      t = <SC_SET_DEFAULT_TIME_UNIT>
     |
      t = <SC_WAIT_ROUTINE>
     |
      t = <SC_NEXT_TRIGGER>
     |
      t = <SC_TRACE>
     |
      t = <SC_CREATE_VCD_TRACE_FILE>
     |
      t = <SC_CREATE_WIF_TRACE_FILE>
     |
      t = <SC_CREATE_ISDB_TRACE_FILE>
     |
      t = <SC_CLOSE_WIF_TRACE_FILE>
     |
      t = <SC_CLOSE_ISDB_TRACE_FILE>
     |
      t = <SC_CLOSE_VCD_TRACE_FILE>
     |
      t = <SC_BIND_ROUTINE>
     |
      t = <SC_REF_ROUTINE>
     |
      t = <SC_CREF_ROUTINE>
     |
      t = <SC_MAIN_MAIN_ROUTINE>
     |
      t = <SC_SET_STOP_MODE_ROUTINE>
     |
      t = <SC_GEN_UNIQUE_NAME_ROUTINE>
     |
      t = <SC_ABS_ROUTINE>
     |
      t = <SC_MAX_ROUTINE>
     |
      t = <SC_MIN_ROUTINE>                 
   )
    expr_list()
   )

   |
    t =  sc_wait_until_statement()
   |
   LOOKAHEAD(3)
    t = sc_spawn_routine()
   |
    name = report_handler_scope()      
  )

   {
     if (name != null)
       jjtThis.setName(name);
     else
       jjtThis.setName(t.image);
   }
}



Token systemCKeyWords() #void :
{Token t = null;}
{

 (
   t = <SC_WAIT_UNTIL_ROUTINE>
  |
   t = <SC_WATCHING_ROUTINE>
  |
   t = <SC_WAIT_ROUTINE>
  |
   t = <SC_NEXT_TRIGGER>
  |
   t = <SC_ASSERT>
  |
   t = <SC_CYCLE>
  |
   t = <SC_INITIALIZE>
  |
   t = <SC_SET_TIME_RESOLUTION>
  |
   t = <SC_GET_TIME_RESOLUTION>
  |
   t = <SC_SET_DEFAULT_TIME_UNIT>
  |
   t = <SC_GET_DEFAULT_TIME_UNIT>
  |
  t = <SC_INTERFACE>
  |
  t = <SC_INT>

  |
  t = <SC_UINT>

  |
  t = <SC_BIGINT>
  |
  t = <SC_BIGUINT>
  |
  t = <SC_IN>
  |
  t = <SC_OUT>
  |
  t = <SC_INOUT>
