void id_expression(boolean mayBeGlSCFunction) #void :
{Token t; boolean isSCRoutine = false; }
{

   (LOOKAHEAD(scope_override_lookahead()) scope_override())?
   ( (
        t = getID()
      | LOOKAHEAD({((isSCRoutineForSCMainOnly() && m_isSC_main) || (!isSCRoutineForSCMainOnly() && !m_isSC_main))})
        t = systemCKeyWords() { isSCRoutine = true; }
     )

     {

       if (isSCRoutine && mayBeGlSCFunction) {
         //throw new ParseException("Parse error at line " + token.beginLine + ", collumn " + token.beginColumn + ".  Encountered: " + t.image);
         generateParseException();
       }

       jjtThis.setName(t.image);

//       if (isSCRoutine && mayBeGlSCFunction) {
//         jjtThis.setSCRoutine(true);
//       }
     }
     #id_expression

     | "operator" optor()  #optor_overloading

     | "~"  getID()

   )


}

void primary_expression()  :
{}
{
     "this" #this_node
//   | ( LOOKAHEAD(2) <STRING> )+
   | pl() expression()  pr()
   |
     LOOKAHEAD( ("::")? "new")
     new_expression()

   |
     LOOKAHEAD( ("::")? "delete") 
     (
       LOOKAHEAD(2) 
       delete_array_expression() 
       |
       delete_expression()
     ) 
   |
     id_expression(true)
   |  LOOKAHEAD(2) constant()
}

void expression_list() #arguments_list :
{}
{    assignment_expression()( "," assignment_expression())*
}

void constant() :
{Token t;}
{  t = <OCTALINT>  {jjtThis.setName(t.image);}
   | t = <OCTALLONG> {jjtThis.setName(t.image);}
   | t = <DECIMALINT> {jjtThis.setName(t.image);}
   | t = <DECIMALLONG> {jjtThis.setName(t.image);}
   | t = <HEXADECIMALINT> {jjtThis.setName(t.image);}
   | t = <HEXADECIMALLONG> {jjtThis.setName(t.image);}

   | t = <UNSIGNED_OCTALINT> {jjtThis.setName(t.image);}
   | t = <UNSIGNED_OCTALLONG> {jjtThis.setName(t.image);}
   | t = <UNSIGNED_DECIMALINT> {jjtThis.setName(t.image);}
   | t = <UNSIGNED_DECIMALLONG> {jjtThis.setName(t.image);}
   | t = <UNSIGNED_HEXADECIMALINT> {jjtThis.setName(t.image);}
   | t = <UNSIGNED_HEXADECIMALLONG> {jjtThis.setName(t.image);}

   | t = <CHARACTER> {jjtThis.setName(t.image);}
   | t = <STRING> {jjtThis.setName(t.image);}
   | t = <FLOATONE> {jjtThis.setName(t.image);}
   | t = <FLOATTWO> {jjtThis.setName(t.image);}
//   | t = <TRUETOK> {jjtThis.setName(t.image);}
//   | t = <FALSETOK> {jjtThis.setName(t.image);}
   | t = boolean_literal() {jjtThis.setName(t.image);}
   | t = sc_constants() {jjtThis.setName(t.image);}
}


Token sc_constants() #void :
{ Token t = null; }

{ (
     t = sc_time_constant()
    |
     t = sc_fp_quantization_constants()
    |
     t = sc_fp_overflow_constants()
    |
     t = sc_context_begin_constant()
    |
     t = sc_switch_constant()
    |
     t = sc_fmt_constant()
    |
     t = sc_numrep_constant()
//    |
//     t = sc_lambda_rator_e_constant() 
    |
     t = sc_lambda_rand_e_constant()
    |
     t = sc_enc_constants()
    |
     t = sc_action_constant()
    |
     t = sc_severity_constant()
    |
     t = sc_stop_mode_constant()
    |
     t = sc_curr_proc_kind_constant()
    |
     t = sc_logic_value_t_constant()
    |
     t = <SC_LOGIC_CONSTANT>
    |
     t = <SC_MAX_NUM_DELTA_CYCLES>
     
  )

  {
    return t;                                         
  }

}

