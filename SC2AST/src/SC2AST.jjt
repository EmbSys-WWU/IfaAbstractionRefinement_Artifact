PARSER_BEGIN(SCParser)
package de.fzi.sim.kascpar.sc2ast;

import de.fzi.sim.kascpar.util.RefInfo;
import de.fzi.sim.kascpar.util.TokenInfo;
import java.util.TreeMap;
import java.util.TreeSet;
/**
 * Parses the input stream (C/C++, System-C file) and generates a corresponding AST.
 */
public class SCParser {

  /**
   * A fixed precision signed and unsigned integer max value of range.
   */
  protected final static int MAX_FIXED_PRECISION_INTEGER = 64;
  
  /**
   * An arbitrary precision signed and unsigned integer max value of range.
   */
  protected final static int MAX_NBITS = 512;

  /**
   * A limited precision fixed point type.
   */
  protected final static int FIXED_FAST_BIT_SIZE = 53;
  
  
/*
  protected final static int CHAR_SIZE_IN_BITS = 8;
  protected final static int SHORT_SIZE_IN_BITS = 16;
  protected final static int INT_SIZE_IN_BITS = 32;
  protected final static int LONG_SIZE_IN_BITS = INT_SIZE_IN_BITS;  
  protected final static int FLOAT_SIZE_IN_BITS = 32;
  protected final static int DOUBLE_SIZE_IN_BITS = 64;
*/  

  protected final static String SC_MODULE_CONST = "sc_module";
  protected final static String SC_MODULE_NAME_CONST = "sc_module_name";
  protected final static String SC_PRIM_CHANNEL_CONST = "sc_prim_channel";
  protected final static String SC_BEHAVIOR_CONST = "sc_behavior";
  protected final static String SC_PROTOCOL_CONST = "sc_protocol";

  protected final static String SC_IN_CONST = "sc_in";
  protected final static String SC_OUT_CONST = "sc_out";
  protected final static String SC_INOUT_CONST = "sc_inout";
  protected final static String BOOL_CONST = "bool";
  
  protected final static String MASTER_BUS_PROTOCOL_BUS_TYPE_CONST = "bus";
  protected final static String MASTER_BUS_PROTOCOL_INDEXED_TYPE_CONST = "indexed";
  protected final static String SC_CURRENT_USER_MODULE_CONST = "SC_CURRENT_USER_MODULE";

  /**
   * Controls the unique ast instance id.
   * Each instance node takes the unique instance id.
   * The member is modified by the method getNewASTInstanceID.
   * The method getASTInstanceID returns the current value of the member field. 
   */  
  protected static long m_curASTInstanceId = 0;

  /**
   * A symbol table manager object. Currently only types and namespaces are recorded for
   * doing semantic predicates for parsing.
   */
   static SymtabManager sym;

  /**
   * Reads a fully qualified name (since it is used during lookahead, we
   * cannot use token. We have to explicitly use getToken).
   */
  static String GetFullyScopedName()
  {
     Token t = getToken(1);

     if (t.kind == SC_CTOR) {
         m_isCTOR_look = true;
       return getToken(3).image;
     }
     else
     if (t.kind != ID && t.kind != SCOPE)
        return null;
     m_isCTOR_look = false;
     StringBuffer s = new StringBuffer();

     int i;
     if (t.kind != SCOPE)
     {
        s.append(t.image);
        t = getToken(2);
        i = 3;
     }
     else
        i = 2;

     while (t.kind == SCOPE)
     {
        s.append(t.image);
        s.append((t = getToken(i++)).image);
        t = getToken(i++);
     }
//     System.out.println(s);
     return s.toString();
  }

  /**
   * This method first tries to read a sequence of tokens of the form
   *             ("::")? <ID> ("::" <ID>)*
   * and if it succeeds then asks the symbol table manager  if this is
   * the name of a constructor.
   */
  static boolean IsCtor()
  {
      return sym.IsCtor(GetFullyScopedName());
  }

  /**
   * Adds a AST node ASTdeclaration_specifiers to the AST.
   * A built type name, a bit length and a systemC flag are set from the corresponding parameters.
   * @param builtTypeName - a type (C++ or SystemC) name.
   * @param length - a length in bit of the type.
   * @param isSCType - a flag should be set to true if builtTypeName is a systemC type.
   *
   */
  static void addDeclaration_specifiers(String builtTypeName, int length, boolean isSCType) {


    ASTdeclaration_specifiers d_sp = new ASTdeclaration_specifiers(null, JJTDECLARATION_SPECIFIERS);
    jjtree.openNodeScope(d_sp);

      ASTbuiltin_type_specifier b_in_t = new ASTbuiltin_type_specifier(null, JJTBUILTIN_TYPE_SPECIFIER);
      jjtree.openNodeScope(b_in_t);

        b_in_t.setName(builtTypeName);
        b_in_t.setLength(length);
        b_in_t.setSystemCDataType(isSCType);
      jjtree.closeNodeScope(b_in_t,true);

    jjtree.closeNodeScope(d_sp, true);

  }
  
  /**
   * Adds a AST node ASTsuperclass_init to the AST.
   *
   */
  static void addSuperClassInitNode() {

     ASTsuperclass_init super_init = new ASTsuperclass_init(null, JJTSUPERCLASS_INIT);
     jjtree.openNodeScope(super_init);

       addDeclaration_specifiers(SC_MODULE_CONST, 0, true);

       ASTarguments_list argl = new ASTarguments_list(null, JJTARGUMENTS_LIST);
       jjtree.openNodeScope(argl);

         ASTprimary_expression prim = new ASTprimary_expression(null, JJTPRIMARY_EXPRESSION);
         jjtree.openNodeScope(prim);

           ASTid_expression id = new ASTid_expression(null, JJTID_EXPRESSION);
           jjtree.openNodeScope(id);
           id.setName("name");

           jjtree.closeNodeScope(id,true);

         jjtree.closeNodeScope(prim,true);

       jjtree.closeNodeScope(argl,true);

     jjtree.closeNodeScope(super_init,true);
  }

  /**
   * Adds a AST node ASTmember_declarator_list to the AST.
   * This is a AST representation of generated with GNU gcc preprocessor code instead of SC_HAS_PROCESS macro.
   */
  static void addHasProcessInstruction(String class_name)
  {

          ASTmember_declarator_list mdl = new ASTmember_declarator_list(null, JJTMEMBER_DECLARATOR_LIST);
          jjtree.openNodeScope(mdl);

            ASTdeclaration_specifiers d_sp = new ASTdeclaration_specifiers(null, JJTDECLARATION_SPECIFIERS);
            jjtree.openNodeScope(d_sp);

              ASTtype_modifiers tm = new ASTtype_modifiers(null, JJTTYPE_MODIFIERS);
              jjtree.openNodeScope(tm);

                ASTstorage_class_specifier storage = new ASTstorage_class_specifier(null, JJTSTORAGE_CLASS_SPECIFIER);
                jjtree.openNodeScope(storage);
                  storage.setName("typedef");

                jjtree.closeNodeScope(storage, true);

              jjtree.closeNodeScope(tm, true);

              ASTqualified_type qt = new ASTqualified_type(null, JJTQUALIFIED_TYPE);
              jjtree.openNodeScope(qt);

                ASTqualified_id qual_id = new ASTqualified_id(null, JJTQUALIFIED_ID);
                jjtree.openNodeScope(qual_id);

                qual_id.setName(class_name);

                jjtree.closeNodeScope(qual_id, true);


              jjtree.closeNodeScope(qt, true);

            jjtree.closeNodeScope(d_sp, true);

            ASTmember_declarator md = new ASTmember_declarator(null, JJTMEMBER_DECLARATOR);
            jjtree.openNodeScope(md);
              ASTdeclarator decl = new ASTdeclarator(null, JJTDECLARATOR);
              jjtree.openNodeScope(decl);

                ASTqualified_id qual_id2 = new ASTqualified_id(null, JJTQUALIFIED_ID);
                jjtree.openNodeScope(qual_id2);
                qual_id2.setName(SC_CURRENT_USER_MODULE_CONST);

                jjtree.closeNodeScope(qual_id2,true);

              jjtree.closeNodeScope(decl,true);

            jjtree.closeNodeScope(md, true);

          jjtree.closeNodeScope(mdl, true);

  }
  /**
   * Adds a AST node ASTparameter_list to the AST.
   * This is a part of the AST representation of generated with GNU gcc preprocessor code instead of SC_CTOR macro.
   */
  static void addCTORInstruction() {
    
    ASTparameter_list p_l = new ASTparameter_list(null, JJTPARAMETER_LIST);
    jjtree.openNodeScope(p_l);

      ASTparameter_declaration p_d = new ASTparameter_declaration(null, JJTPARAMETER_DECLARATION);
      jjtree.openNodeScope(p_d);

        addDeclaration_specifiers(SC_MODULE_NAME_CONST, 0, true);
        
        ASTdeclarator decl = new ASTdeclarator(null, JJTDECLARATOR);
        jjtree.openNodeScope(decl);

          ASTqualified_id qual_id = new ASTqualified_id(null, JJTQUALIFIED_ID);
          jjtree.openNodeScope(qual_id);
          qual_id.setName("name");

          jjtree.closeNodeScope(qual_id,true);

        jjtree.closeNodeScope(decl,true);

      jjtree.closeNodeScope(p_d,true);

    jjtree.closeNodeScope(p_l,true);

  }
  /**
   * Tests if the token is a systemC base class(sc_module,..).
   * @param t - a possible a systemC base class.
   * @return true if the token t is a systemC base class, false otherwise.
   */
  static boolean isSCBaseClass(Token t) {

    if (t.kind == SC_MODULE
         ||
           t.kind == SC_PRIM_CHANNEL
         ||
           t.kind == SC_CHANNEL
         ||
           t.kind == SC_BEHAVIOR) {
      return true;
    }
    else
      return false;
  }

  /**
   * Tests if the next token in the input stream is a systemC routine and this routine should be used in sc_main only.
   * @return true if the next token in the input stream is a systemC routine
   * and this routine should be used in sc_main only, false otherwiae.
   */
  static public boolean isSCRoutineForSCMainOnly() {

    Token t = getToken(1);

    if (t.kind == SC_CYCLE
      || t.kind == SC_START
      || t.kind == SC_INITIALIZE)
      return true;
    else
      return false;

  }

  /**
   * Tests if the input stream from the id token till the "<<" or ";" token is a parenthesis balanced.
   * @return true if the input stream is a parenthesis balanced, false otherwise.
   */
  static boolean isParanthBalancedExpr(int id)
  {
     int paranth_count = 0, i = id;
     Token t = getToken(i);
     while ((t.kind != SHIFTLEFT && t.kind != SEMICOLON ) ) {
       if (t.kind == LPARENTHESIS)
         ++paranth_count;
       else
       if (t.kind == RPARENTHESIS) {
         if (paranth_count == 0)
           return true;
         --paranth_count;
       }  
       t = getToken(++i);
        
     }

     if (paranth_count == 0)
       return true;
     else
       return false;  
  }

  
  /**
   * Controls a adding a result of permutation the SC_HAS_PROCESS macro or not.
   * @param value 0 - avoids a entry in AST tree, 1 - allows a entry in the AST tree.
   */
  public static void setHasProcessMacroElab(int value) {
    m_hasProcessMacroElab = value;
  }
  
  /**
   * Returns a new unique id for the AST instance.
   * 
   */
   public static long getNewASTInstanceID() {
     
       return ++m_curASTInstanceId;
   }

  /**
   * Returns a current unique id of the last created AST instance.
   * 
   */ 
   public static long getASTInstanceID() {
     
      return m_curASTInstanceId;
   }

  /**
   * Gets a line mapping information of token with id number into the input token stream.
   * @param id - a number into the input token stream.
   * @return null if the line mapping information for this token is not found, otherwise the TokenInfo object.
   * @see de.fzi.sim.kascpar.util.TokenInfo
   */
  public static TokenInfo getExtLineInfo(int id) {
    RefInfo  ptrRef = null;
    if (m_lineMapper != null) {

      if (token.image == null)
        return null;

      if (token.next == null)
        id = 0;
          
      Integer int_t = null;

      if (id == 0)
        int_t = new Integer(token.beginLine-1);
      else
        int_t = new Integer(token.next.beginLine-1);  

      if(m_lineMapper.containsKey(int_t)) {
        ptrRef =  (RefInfo) m_lineMapper.get(int_t);
      }

      if (ptrRef != null) {
        return new TokenInfo(ptrRef, token.beginColumn);
      }
    }
    return null;
  }
  
  /**
   * Gets a line mapping information for a corresponding line and a column in a common source file.
   * @param line - a line in a common source file.
   * @param column - a column in a common source file.   
   * @return null if the line mapping information for this token is not found, otherwise the TokenInfo object.
   * @see de.fzi.sim.kascpar.util.TokenInfo
   */
  public static TokenInfo getExtLineInfo(int line,int column) {
    RefInfo  ptrRef = null;
    if (m_lineMapper != null) {


      Integer int_t = new Integer(line - 1);

      if(m_lineMapper.containsKey(int_t)) {
        ptrRef =  (RefInfo) m_lineMapper.get(int_t);
      }

      if (ptrRef != null) {
        return new TokenInfo(ptrRef, column);
      }
    }
    return null;
  }

  
  /**
   * Gets error message with line, column information.
   * It tries to take a line mapping information correspond to the current token in the input token stream.
   * @return a error message.
   *
   */
  public static String getErrorMessage()
  {
      Token errortok = token.next;
      int line = errortok.beginLine, column = errortok.beginColumn;

      TokenInfo t = getExtLineInfo(1);
      String mess = (errortok.kind == 0) ? tokenImage[0] : errortok.image;
      if (t != null) {
        mess = "Parse error at line " + (t.refInfo().line()+1) + ", column " + t.column() + ", file " + t.refInfo().file() + ". Encountered: " + mess;
      }
      else {
        mess = "Parse error at line " + line + ", column " + column + ".  Encountered: " + mess;
      }
      return mess;
  }

  /**
   * Sets the result dictionary of the line mapping algorithm
   * The key is a object of the Integer, the value is a object of the RefInfo class in this dictionary.
   * @see de.fzi.sim.kascpar.util.RefInfo
   * @see de.fzi.sim.kascpar.util.LineMapper
   */
  public static void setLineMappingTable(TreeMap map)
  {
    m_lineMapper = map;
  }

  /**
   * Returns true if a next token(s) in the input token stream is(are) a declared class name.
   */
  static boolean  class_name_lookahead()
  {
    Scope sc = null;
    if (m_cur_scope_in_comp_name == null) {
      sc = sym.GetScopeOfScopedName(getToken(1).image);
    }
    else {
      sc = sym.GetScopeOfScopedName(m_cur_scope_in_comp_name + "::" + getToken(1).image);
    }  

    if (sc != null) {
      return sc.IsClass();
    }  
    else {
      return false;
    }  
  }

  /**
   * Returns true if a next token(s) in the input token stream is(are) a declared namespace name.
   */
  static boolean namespace_name_lookahead()
  {
    Scope sc = null;
    if (m_cur_scope_in_comp_name == null) {
      sc = sym.GetScopeOfScopedName(getToken(1).image);
    }
    else {
      sc = sym.GetScopeOfScopedName(m_cur_scope_in_comp_name + "::" + getToken(1).image);
    }

    if (sc != null) {
      return sc.IsNamespace() && !sc.IsAliasNamespace();
    }  
    else {
      return false;
    }  
  }

  /**
   * Returns true if a next token(s) in the input token stream is(are) a declared allias namespace name.
   */
  static boolean alias_namespace_name_lookahead()
  {

    Scope sc = null;
    if (m_cur_scope_in_comp_name == null) {
      sc = sym.GetScopeOfScopedName(getToken(1).image);
    }
    else {
      sc = sym.GetScopeOfScopedName(m_cur_scope_in_comp_name + "::" + getToken(1).image);
    }  
    if (sc != null) {
      return sc.IsNamespace() && sc.IsAliasNamespace();
    }  
    else
      return false;

  }

  /**
   *  Returns true if the class member is constant, static and is a built in type of C/C++.
   */
  static  boolean isAllowMemberInitialization() {
    return (m_isStatic && m_isConst && m_isCBuiltInType);
  }
  /**
   * Returns a string representation of i1 and i2 separated with "_".
   */
  static String strKey(int i1, int i2) {
    return new String(Integer.toString(i1) + "_" + Integer.toString(i2));
  }
  /**
   * Registers the behaviour with the comments in source code during parse.
   */
  public static void elaborateComments(boolean flag)
  {
    SimpleNode.m_elaborateComments = flag;
  }

  /**
   * Registers the behaviour with the line mapping information during the AST generation.
   */
  public static void saveFileLineColumnInfoInAST(boolean flag) {
    
    SimpleNode.m_fileLineColumnSaving = flag;
  }

  /**
   * Tries to find a comment in the input token stream.
   * If a comment is not already in AST, adds it to the AST.
   *
   */
  static void addCommentToAST() {

       
    Token t = getToken(1);

    if (t.specialToken == null) return;

    // The above statement determines that there are no special tokens
    // and returns control to the caller.

    Token tmp_t = t.specialToken;

    while (tmp_t.specialToken != null)
      tmp_t = tmp_t.specialToken;

      // The above line walks back the special token chain until it
      // reaches the first special token after the previous regular
      // token.
    int kind = 0;
    String str = new String("");
    int line = 0, column = 0;
    while (tmp_t != null) {


      if (kind == 0) {
        if (tmp_t.image.indexOf("//") != -1) {
          kind = 1;
        }
        if (tmp_t.image.indexOf("/*") != -1) {
          kind = 2;
        }

        line = tmp_t.beginLine;
        column = tmp_t.beginColumn;
      }

      if (kind == 1) {
        if (tmp_t.image.indexOf('\n') != -1) {
          addCommentNodeToAST(str + tmp_t.image.substring(0,tmp_t.image.indexOf('\n')),
                              line,
                              column);
          kind = 0;
          str = "";
        }
        else
          str += tmp_t.image;
      }
      else
      if (kind == 2) {
        if (tmp_t.image.indexOf("*/") != -1) {
          addCommentNodeToAST(str + tmp_t.image.substring(0,tmp_t.image.indexOf("*/") + 2),
                              line,
                              column);
          kind = 0;
          str = "";
        }
        else
          str += tmp_t.image;

      }
      tmp_t = tmp_t.next;
    }

  }

  /**
   * Creates a new AST node ASTcomment with text, line, column and adds this object to the AST.
   */
  static void addCommentNodeToAST(String text, int line, int column) {

    if (m_isFirst == false)
      return;
    String str = strKey(line,column);
    if (m_comentSet.contains(str)) {
      return;
    }
    else
      m_comentSet.add(str);
    
      TokenInfo t = getExtLineInfo(line, column);

    ASTcomment id = new ASTcomment(JJTCOMMENT, t);
    jjtree.openNodeScope(id);
      id.setName(text);
    jjtree.closeNodeScope(id,true);
    
  }

  /**
   * A parenthesis balance flag.
   */
  protected static boolean m_isBal;

  /**
   * Flag of a adding the result of permutation the SC_HAS_PROCESS macro or not. 
   */
  protected static int m_hasProcessMacroElab;
  /**
   * Contains true if a current standart C++ stream is cout and false if the current standart C++ stream is cerr.
   */
  protected static boolean m_isStream_output;

  /**
   * Contains true if the macro SC_CTOR is found in a current processed module.
   */
  protected static boolean m_isCTOR, m_isCTOR_look;
  /**
   * Contains true if a current processed module inherits direct from sc_module, sc_channel.., or has a special systemC macro(SC_CTOR,...).
   */
  protected static boolean m_isExtOfSCClass;
  /**
   * Contains true if a current processed token is in the sc_main function.
   */
  protected static boolean m_isSC_main;
  /**
   * Contains line mapping dictionary if a current processed token is in the sc_main function.
   * The key is a object of the Integer, the value is a object of the RefInfo class in this dictionary.
   */
  protected static TreeMap m_lineMapper;
  /**
   * Stores a current name of scope in the complicated name.
   */
  protected static String m_cur_scope_in_comp_name;
  /**
   * boolean flag is used to control a initialization of a member.
   */
  protected static boolean m_isStatic, m_isConst, m_isCBuiltInType;
  /**
   * Shows a begining of the parsing.
   */
  protected static boolean m_isFirst;
  /**
   * It is used to control the comments occurence in the AST.
   */
  protected static TreeSet m_comentSet;

}



PARSER_END(SCParser)

TOKEN_MGR_DECLS :
{
   static int beginLine;
   static int beginCol;
   static boolean lineDirective = false;

   static void resetBeginLineCol()
   {
   }
}

SKIP : {
  <["\r"]"\n">
}

/* SKIP : */
 SPECIAL_TOKEN:
{
 "\n"
|
  " "
|
  "\t"
|
  "//" : IN_LINE_COMMENT
|
  "/*" : IN_COMMENT
|
  < "#" ([" ", "\t"])* "line" > : LINE_NUMBER
|
  < "#" ([" ", "\t"])* ["0"-"9"] > { input_stream.backup(1); } : LINE_NUMBER

}

<LINE_NUMBER> SKIP:
{
   < (["0"-"9"])+ >
   {
     try
     {
        beginLine = Integer.parseInt(image.toString());
     }
     catch(NumberFormatException e) { } // Will never come here.
   } : LINE_DIRECTIVE
}

<LINE_DIRECTIVE> SKIP:
{
  "\n"   : AFTER_LINE_DIRECTIVE
|
  <~[]>
}

<AFTER_LINE_DIRECTIVE> SKIP:
{

  <~[]>
  {
     input_stream.adjustBeginLineColumn(beginLine, 1);
     input_stream.backup(1);
  } : DEFAULT
}


<IN_LINE_COMMENT>
SPECIAL_TOKEN:                    /*SKIP:*/
{
   "\n"  : DEFAULT
}

<IN_LINE_COMMENT> MORE:
{
  < ~[] >
}

<IN_COMMENT>
SPECIAL_TOKEN:     /*SKIP:*/
{
   "*/" : DEFAULT
}

<IN_COMMENT> MORE:
{
  < ~[] >
}


//<PREPROCESSOR_OUTPUT> SKIP:
//{
//   "\n"   : DEFAULT
//}




TOKEN :
{


  < LCURLYBRACE: "{" >
| < RCURLYBRACE: "}" >
| < LSQUAREBRACKET: "[" >
| < RSQUAREBRACKET: "]" >
| < LPARENTHESIS: "(" >
| < RPARENTHESIS: ")" >
| < SCOPE: "::" >
| < COLON: ":" >
| < SEMICOLON: ";" >
| < COMMA: "," >
