int constant_int() #void:
{Token t = null; }

{  

   t = <OCTALINT> { if (t.image.length() == 1)
                        return 0;
                      else
                        return Integer.parseInt(t.image.substring(1), 8);
                  }
   | t = <DECIMALINT> { return Integer.parseInt(t.image, 10); }                    
   | t = <HEXADECIMALINT> { return Integer.parseInt(t.image.substring(2), 16); }
}

Token boolean_literal() #void:
{Token t = null;}
{
  (
    t=<TRUETOK>
   |
    t=<FALSETOK>
  )

  { return t; }
}

void optor() :
{}
{
     "new" [ LOOKAHEAD(2) "[" "]" ]
   | "delete" [ LOOKAHEAD(2) "[" "]" ]
   | "+"
   | "-"
   | "*"
   | "/"
   | "%"
   | "^"
   | "&"
   | "|"
   | "~"
   | "!"
   | "="
   | "<"
   | ">"
   | "+="
   | "-="

   | "*="
   | "/="
   | "%="
   | "^="
   | "&="
   | "|="
   | "<<"
   | ">>"
   | ">>="
   | "<<="
   | "=="
   | "!="
   | "<="
   | ">="
   | "&&"
   | "||"
   | "++"
   | "--"
   | ","

   | "->*"
   | "->"
   | pl() pr()
   | "[" "]"
   | declaration_specifiers() (LOOKAHEAD(2) ("*"|"&"))?
}

void exception_spec() :
{}
{
   "throw" pl() exception_list() pr()
}


void exception_list() :
{}
{
   type_name() ( "," type_name())*
}

TOKEN :
{
  <  ID : ["a"-"z","A"-"Z", "_"] (["a"-"z","A"-"Z","0"-"9","_"])* >
}


void output_stream() :

{ Token t = null;
  boolean isStdPrefix = false;
 }

{
  ( t = <COUT>
   |
    t = <CERR>
  )
  {
   if (isStdPrefix) 
     jjtThis.setName(new String("std::") + t.image);
   else
     jjtThis.setName(t.image);
  
    
    m_isStream_output = true;
    m_isBal = false;
  }

   (
     (

      "." postfix_expression() #postfix_expression <SEMICOLON>


     )
    |
     (
      standart_output_stream_helper()
      (   // LOOKAHEAD(standart_output_stream_helper())
            standart_output_stream_helper()
      )*

      <SEMICOLON>
     )
   )  
  { if(m_isStream_output) {
      m_isStream_output = false;
      m_isBal = false;
    }
  }

}


void standart_output_stream_helper() #void :
{}

{
  "<<" (
   {     
     m_isBal = isParanthBalancedExpr(1);
//     System.out.println("m_isBal is " + m_isBal);
   }
   (
    LOOKAHEAD(3)
      standart_manipulator() 
    |
     expression()
   ) 


  )    
}

void standart_manipulator() :
{ Token t; boolean isStdPrefix = false;}
{
  //["std::" {isStdPrefix = true;}]
  (
    t = <SC_IO_MANIPULATORS>
   |
    t = <SC_IO_MANIPULATOR_WITH_PARAM> pl() expression_list() pr()
  )
  {
    if (isStdPrefix)
      jjtThis.setName(new String("std::") + t.image);
    else
      jjtThis.setName(t.image);
  }
}
void pl() #void :
{

}
{
  "(" 
}


void pr() #void :
{

}
{
  ")" 

}

void sc_has_process_declaration() #void:
{ Token t = null; }
{
  <SC_HAS_PROCESS> pl() t = getID() pr()
    {
      if (m_hasProcessMacroElab != 0)
        addHasProcessInstruction(t.image);
       
      m_isExtOfSCClass = true;
    }
}

void sc_map_to_target_declaration() :
{ Token t = null; }
{
  t = <SC_MAP_TO_TARGET_INIT_MACRO> { jjtThis.setName(t.image); }
}

void sc_map_to_target() :
{ Token t = null, t2 = null, t3 = null, t_name; int id = -1; String s = null; }
{
  
  t_name =  <SC_MAP_TO_TARGET_MACRO> pl() t = getID() <COMMA>
                                    t2 = <STRING> <COMMA>
                                    ( id = constant_int() { s = Integer.toString(id); }
                                     |
                                      t3 = getID()  { s = t3.image;}
                                    )  

                               pr()
  {
    jjtThis.setName(t_name.image);
    jjtThis.setObject(t.image);
    jjtThis.setTarget(t2.image);
    jjtThis.setInstanceId(s);    
  }                   
    
}

void namespace_definition() :
{}
{
   LOOKAHEAD(2)
   named_namespace_definition()
  |
   unnamed_namespace_definition()
}

void named_namespace_definition() :
{}
{
   LOOKAHEAD(<NAMESPACE>  getID(), { (sym.GetScope(getToken(2).image) == null) })
    original_namespace_definition()

  |
    extended_namespace_definition()
}


void original_namespace_definition() :
{Token t = null;}
{
  <NAMESPACE>  t = getID()
  {
    sym.OpenScope(t.image, false);
  }

  "{" namespace_body() "}"
  
  {
    sym.CloseScope();
    
    jjtThis.setName(t.image);
  }
}


void extended_namespace_definition() :
{Token t = null;
 Scope sc = null;
 Scope old = null;
}
{
  <NAMESPACE>  t = getID()
  {
    sc = sym.GetScope(t.image);
    if (sc != null) {
      old = sym.GetCurScope();
      sym.SetCurrentScope(sc);
    }
  }

   "{" namespace_body() "}"
   {
     if (old != null) {
      sym.SetCurrentScope(old);
     }
     jjtThis.setName(t.image);
   }
}

void unnamed_namespace_definition() :

{}
{
  <NAMESPACE>
   // unnames namespace is visible after definition!!! -> trick without scope!
   //{ sym.OpenScope(null, false); }

   "{" namespace_body() "}"

   // { sym.CloseScope(); }
   
}

void namespace_declaration() #void :
{ boolean isTypedef;}

{
    LOOKAHEAD(("typedef" | template_head())? class_head()  "{")
       ( template_head() )? declaration()
   |
    LOOKAHEAD("enum" (getID())? "{")
       enum_specifier() (init_declarator_list(false))?  ";"
   |
    LOOKAHEAD ((template_head())? dtor_ctor_decl_spec()
                               dtor_declarator() "{")
       dtor_definition()
   |
    LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
       ctor_definition()

   |
    LOOKAHEAD(function_definition())
       function_definition()

   |
    LOOKAHEAD((scope_override())? "operator")
         conversion_function_decl_or_def()
   |
    template_head()
      (

        LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
           ctor_definition()
      |
        LOOKAHEAD((declaration_specifiers())?  function_declarator_lookahead())
           function_definition()
      |
        isTypedef = declaration_specifiers()
               (init_declarator_list(isTypedef))?  ";"
      )
   |
   LOOKAHEAD(3)
    declaration()
   |
    ";"
   |
   preprocessor_directive()
   |
    fzi_sim_directive()
   |
    namespace_definition()
   |
   LOOKAHEAD(2)
    sc_main_declaration()
}
void namespace_body() :
{}
{
   (namespace_declaration())*
}

void alias_namespace_definition() :
{
  Token t = null;
  String name = null;
  Scope sc = null;
}
{
  <NAMESPACE> t = getID() <ASSIGNEQUAL> { name = GetFullyScopedName(); } namespace_qualified_spec() ";"
  {
    sc = sym.GetScopeOfScopedName(name);
    if (sc != null && sc.IsNamespace()) {
      
      sym.OpenScope(t.image, false);

      sym.GetCurScope().SetReferenceNamespace(sc);
      sym.CloseScope();
    }
    jjtThis.setName(t.image);  
  }
}

void namespace_qualified_spec() :
{}
{
  
 [<SCOPE>] { m_cur_scope_in_comp_name = null; }
 [LOOKAHEAD(complicated_name_spec()) complicated_name_spec()]
 
 namespace_name()

 {m_cur_scope_in_comp_name = null;}
 
}

void using_declaration() :
{
  String type = null;
  Scope sc = null;
  String name = null;
}

{
  (
    LOOKAHEAD(2)
     ( <USING> [<TYPENAME>] { name = GetFullyScopedName(); } 

     {m_cur_scope_in_comp_name = null;} complicated_name_spec() {m_cur_scope_in_comp_name = null;})
    |
     (<USING> { name = GetFullyScopedName(); } <SCOPE> )
  )
  type = not_qualified_id() ";"
  {
    
    sc = sym.GetScopeOfFullyScopedName(name);
    if (sc != null) {

      if ( sc.IsTypeName2(type)) {
        ((Scope)sym.GetCurScope()).AddTypeFromNamespace(type);
      }

    }   
    
    jjtThis.setName(name);
  }
}



void using_directive() :

{
  Scope sc = null;
  String name = null;

}
{
  <USING> <NAMESPACE> { name = GetFullyScopedName(); }
  namespace_qualified_spec() ";"
  {
    sc = sym.GetScopeOfScopedName(name);
    if (sc != null) {
      if (sc.IsNamespace() || sc.IsAliasNamespace()) {
        ((Scope)sym.GetCurScope()).AddNamespace(sc);
      }
    }  
    jjtThis.setName(name);
  }
}

void class_or_namespace_name() :
{ }
{
  (
   LOOKAHEAD(2)
    class_name()
   |
    namespace_name()
  )

  <SCOPE>

}


void complicated_name_spec() :

{ }

{
   class_or_namespace_name()

   (
    [LOOKAHEAD(2) complicated_name_spec()]
   )
  |
   (

    <TEMPLATE>

    complicated_name_spec()
   )
  
}

void complicated_name_spec_without_template() #complicated_name_spec :

{ }

{
   class_or_namespace_name()

   (
    [LOOKAHEAD(2) complicated_name_spec()]
   )
}


void namespace_name() :
{}
{ LOOKAHEAD({namespace_name_lookahead()})
   original_namespace_name()
  |
  LOOKAHEAD({alias_namespace_name_lookahead()})
   alias_namespace_name()
}

void original_namespace_name() :
{Token t = null;}
{
  {
     if (m_cur_scope_in_comp_name == null) {
       m_cur_scope_in_comp_name = getToken(1).image;
     }
     else
       m_cur_scope_in_comp_name += "::" + getToken(1).image;
   }


  t = getID() {jjtThis.setName(t.image);}
}

void alias_namespace_name() :
{Token t = null;}
{
  t = getID() {jjtThis.setName(t.image);}
}

String not_qualified_id() :
{Token t = null;}
{
  t = getID() {jjtThis.setName(t.image);}
  {return t.image; }
}

void class_name() :
{}
{ 
  LOOKAHEAD(2)
   template_id()
  |
  LOOKAHEAD( { class_name_lookahead() } )
  (
   { if (m_cur_scope_in_comp_name == null) {
       m_cur_scope_in_comp_name = getToken(1).image;
     }
     else
       m_cur_scope_in_comp_name += "::" + getToken(1).image;
   }
   not_qualified_id()
  )
}

void comment() :
{

}
{
  "`"
}

/*end*/
























