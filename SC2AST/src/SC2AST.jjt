////     )
//     pl() qualified_id() pr() ";"
//   )
//}



//void sensitive_item() :
//{String s;}
//{
//  s = qualified_id() {jjtThis.setName(s);}
//}

void sc_notify() :
{
 Token t1 = null;
 String s = "";
 String cur;
 String access_cur, access_last = "";

}
{

  ( t1 = getID() { cur = t1.image; }
         ( pl() pr() {cur += "()";} )?
        ("->" {access_cur = "->";} |"." { access_cur = ".";})

         {
           if (s.length() != 0)
             s = s + access_last + cur;
           else
             s = cur;

           access_last = access_cur;
         }
  )*



  <SC_NOTIFY> pl() ( expression_list() )?  pr()
  {
    if(s.length() > 0)
      jjtThis.setName(s);
  }

}

void function_definition() :
{
   Scope sc = null;
   boolean isTypedef;
}
{
(
    LOOKAHEAD(3) isTypedef = declaration_specifiers()
        sc = function_declarator(isTypedef) func_decl_def(sc)
   |
    sc = function_declarator(false) func_decl_def(sc)
)
}

/* veraendert */
void func_decl_def(Scope sc) #void :
{
   boolean closeReqd = false;
}
{
  {
     if (closeReqd = (sc != null && sc != sym.GetCurScope()))
        sym.SetCurrentScope(sc);
  }

  (
    ";"                  // deklaration
   |

    compound_statement() // deklaration und definition
  )


  { if (closeReqd) sym.CloseScope(); }
}

void linkage_specification() :
{}
{
   "extern" <STRING>
   (
    "{" ( external_declaration() )* "}"
      ( LOOKAHEAD(";") ";")?
   |
    declaration()
   )
}

void declaration() :

{ boolean isTypedef = false; }

{
    LOOKAHEAD(5)
      (isTypedef = declaration_specifiers()
               [ LOOKAHEAD( init_declarator_list(isTypedef) ) init_declarator_list(isTypedef) ] ";" ) #init_declarator_list(>1)

   |
    linkage_specification()
   |
    alias_namespace_definition()
   |
   LOOKAHEAD(2)
    using_declaration()
   |
    using_directive()
}


/**
 * Very temporary. Just returns true if it sees a typedef. Finally, we will
 * need a structure that stores all the attributes.
 */
boolean type_modifiers() :

{ boolean isTypedef = false; Token t = null;}
{
   (
     isTypedef = storage_class_specifier()
    |
     type_qualifier()
    |

     t = <INLINE>
    |
     t = <VIRTUAL>
    |
     t = <FRIEND>

    {if (t != null) jjtThis.setName(t.image);}
   )

   { return isTypedef; }
}

/**

 * Very temporary. Just returns true if it sees a typedef. Finally, we will
 * need a structure that stores all the attributes.
 */
boolean declaration_specifiers() :
{
   String name = null;
   boolean isTypedef = false, tmp;
}
{
   [ LOOKAHEAD(scope_override_lookahead()) name = scope_override()  ]
 (
   (
      LOOKAHEAD(type_modifiers()) tmp = type_modifiers() { isTypedef |= tmp; }
   )+


    [ LOOKAHEAD(2) (
     
     LOOKAHEAD(builtin_type_specifier()) builtin_type_specifier() 
         (  LOOKAHEAD(2) (
            LOOKAHEAD(builtin_type_specifier()) builtin_type_specifier()
          |
            LOOKAHEAD(type_modifiers()) tmp = type_modifiers() )
                                        { isTypedef |= tmp; }
         )*
    |
     (
        qualified_type() 
      |
        class_specifier()
      |
        enum_specifier()
     )
     (LOOKAHEAD(2) tmp = type_modifiers() { isTypedef |= tmp;} )*
    ) ]
   |

    LOOKAHEAD(builtin_type_specifier()) builtin_type_specifier()
         ( LOOKAHEAD(2) (
            LOOKAHEAD(builtin_type_specifier()) builtin_type_specifier()
          |
            tmp = type_modifiers() { isTypedef |= tmp; } )
         )*
   |
    (
     
     qualified_type() 
    |
      class_specifier()
    |
      enum_specifier()
    
    )
    (LOOKAHEAD(2) tmp = type_modifiers() { isTypedef |= tmp; } )*
 )

 { return isTypedef; }
}




void type_specifier() :
{}
{
    simple_type_specifier()
   |
    class_specifier()
   |
    enum_specifier()
}


void simple_type_specifier() :
{}
{
   (
   LOOKAHEAD(4)
    builtin_type_specifier()
   |
    qualified_type()
   )
}


void scope_override_lookahead() :
{}
{
    "::"

   |
    getID() ("<" template_argument_list() ">")? "::"
}

String scope_override() :
{
   String name = "";
   Token t;

}
{
  (
    ("::")  { name += "::"; }
    (
      LOOKAHEAD(getID() ( "<" template_argument_list() ">")? "::" ) t = getID()  ("<" template_argument_list() ">")? "::"
                   { name += t.image + "::"; }
    )*
   |
    (
      LOOKAHEAD(getID() ( "<" template_argument_list() ">")? "::") t = getID()  ("<" template_argument_list() ">")? "::"
                   { name += t.image + "::"; }
    )+
  )

  { 
    jjtThis.setName(name.substring(0, name.length()-2));
    return name;
  }
}

