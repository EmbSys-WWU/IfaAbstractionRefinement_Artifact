//| <SC_LAMBDA_RATOR_E_CONSTANTS4: "SC_LAMBDA_INT_SUB" | "SC_LAMBDA_INT_MUL" | "SC_LAMBDA_INT_DIV" | "SC_LAMBDA_INT_REM" | "SC_LAMBDA_INT_BITAND" | "SC_LAMBDA_INT_BITOR" | "SC_LAMBDA_INT_BITNOT" | "SC_LAMBDA_INT_BITXOR">
| <SC_LAMBDA_RAND_E_CONSTANTS:    "SC_LAMBDA_RAND_LAMBDA" | "SC_LAMBDA_RAND_SIGNAL_INT" | "SC_LAMBDA_RAND_SIGNAL_SUL" | "SC_LAMBDA_RAND_SIGNAL_BOOL" | "SC_LAMBDA_RAND_INT" | "SC_LAMBDA_RAND_SUL" | "SC_LAMBDA_RAND_BOOL">
| <SC_ENC_CONSTANTS:    "SC_TC_" | "SC_US_">
                                                                
| <SC_SEVERITY_CONSTANTS: "SC_INFO" | "SC_WARNING" | "SC_ERROR" | "SC_FATAL" >
| <SC_ACTION_CONSTANTS: "SC_UNSPECIFIED" | "SC_DO_NOTHING" | "SC_THROW" | "SC_LOG" | "SC_DISPLAY" | "SC_CACHE_REPORT" | "SC_INTERRUPT" | "SC_STOP" | "SC_ABORT" >
| <SC_REPORT_HANDLER_METHODS : "report" | "set_handler" | "set_actions" | "stop_after" | "suppress" | "force" | "get_new_action_id" | "get_log_file_name"
                               | "set_log_file_name" | "get_cached_report" | "clear_cached_report">
| <SC_STOP_MODE_CONSTANTS : "SC_STOP_IMMEDIATE" | "SC_STOP_FINISH_DELTA" >
| <SC_CURR_PROC_KIND_CONSTANTS : "SC_NO_PROC_" | "SC_METHOD_PROC_" | "SC_THREAD_PROC_" | "SC_CTHREAD_PROC_" >
| <SC_IO_MANIPULATORS :  "boolalpha" | "noboolalpha" | "showbase" | "showpoint"
                       | "noshowpoint" | "showpos" | "noshowpos" | "skipws" | "noskipws" | "uppercase" | "nouppercase"
                       | "internal" | "left" | "right" | "dec" | "hex" | "oct" | "fixed" | "scientific"
                       | "endl" | "ends" | "flush" | "ws">
| <SC_IO_MANIPULATOR_WITH_PARAM : "resetiosflags" | "setiosflags" | "setbase" | "setfill" | "setprecisionl" | "setw">
| <SC_LOGIC_VALUE_T_CONSTANT : "Log_0" | "Log_1" | "Log_Z" | "Log_X" >
| <SC_LOGIC_CONSTANT : "SC_LOGIC_0" | "SC_LOGIC_1" | "SC_LOGIC_Z" | "SC_LOGIC_X" >
| <  CHARACTER : ("L")? "'"
   (   (~["'","\\","\n","\r"])
   | ("\\" (
             ["n","t","v","b","r","f","a","\\","?","'","\""]
            |
             "0" (["0"-"7"])*
            |
             ["1"-"9"] (["0"-"9"])*
            |
             ("0x" | "0X") (["0"-"9","a"-"f","A"-"F"])+
           )
     )
   )
   "'" >

| <  STRING : ("L")? "\""

   ( ( ~["\"","\\","\n","\r"])
   | ("\\" (
             ["n","t","v","b","r","f","a","\\","?","'","\""]
            |

             "0" (["0"-"7"])*
            |
             ["1"-"9"] (["0"-"9"])*
            |
             ("0x" | "0X") (["0"-"9","a"-"f","A"-"F"])+
           )
     )
   )*
   "\"" >
}

TOKEN: {
<PREPROCESSOR_OUTPUT : "#" (~["\n","\\"])+ >
|
<FZI_SIM_PRAGMA : "//pragma_SysXplorer">
|
<FZI_SIM_PRAGMA_ITER_TYPE : "iterations" >
|
<FZI_SIM_PRAGMA_SIGNAL_TYPE : "signal" >
}


ASTtranslation_unit translation_unit() :
{}
{  {

    sym.OpenScope(null, false);
    m_isSC_main = false;
    m_isStream_output = false;
    m_isBal = true;
    m_isFirst = false;
    m_comentSet = new TreeSet();
    // resets the instance counter.
    m_curASTInstanceId = 0;
   } 
    
   ( LOOKAHEAD(2) external_declaration() )* <EOF>
   { sym.CloseScope();

   return jjtThis; }
}

Token getID() #void :
{Token t = null;}
{  (
     t = <ID>
    |
     t = <FZI_SIM_PRAGMA_SIGNAL_TYPE>
    |
     t = <FZI_SIM_PRAGMA_ITER_TYPE>
    |
     t = <SC_IO_MANIPULATORS>
    |
     t = <SC_IO_MANIPULATOR_WITH_PARAM>
    |
     t = <SC_REPORT_HANDLER_METHODS>
     
   )
   { return t;}
}
void preprocessor_directive() :
{Token t; }
{
   t = <PREPROCESSOR_OUTPUT> {
//    System.out.println(t.image);
//
//    System.out.println(getToken(1).image);
//    System.out.println(getToken(2).image);
//    System.out.println(getToken(3).image);
//    System.out.println(getToken(4).image);
      jjtThis.setName(t.image);


     while(getToken(1).image.equals("\\")){
       // shifts token pointer forward
       getNextToken();
       // skips all "\\" tokens
       while(getToken(1).image.equals("\\"))
        getNextToken();

       jjtThis.setName(jjtThis.name() + getToken(1).image);
       // shifts token pointer forward
       getNextToken();
     }
   }
   ("\\")?
}


void external_declaration() :
{ boolean isTypedef = false;
  m_isFirst = true;
}
{
    LOOKAHEAD(("typedef" | template_head())? class_head()  "{")
       ( template_head() )? declaration()
   |
    LOOKAHEAD("enum" (getID())? "{")
       enum_specifier() (init_declarator_list(false))?  ";"
   |
    LOOKAHEAD ((template_head())? dtor_ctor_decl_spec()
                               dtor_declarator() "{")
       dtor_definition()
   |
    LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
       ctor_definition()

   |
    LOOKAHEAD(<USING>)
     declaration()
   |
    LOOKAHEAD(function_definition())
       function_definition()

   |
    LOOKAHEAD((scope_override())? "operator")
         conversion_function_decl_or_def()
   |
    template_head()
      (
        LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
           ctor_definition()
      |
        LOOKAHEAD((declaration_specifiers())?  function_declarator_lookahead())
           function_definition()
      |
        isTypedef = declaration_specifiers()
               (init_declarator_list(isTypedef))?  ";"
      )
   |
   LOOKAHEAD(3)
    declaration()
   |
    ";"
   |

   preprocessor_directive()
   |
    fzi_sim_directive()
   |
    namespace_definition()
   |
   LOOKAHEAD(2)
    sc_main_declaration()

}

void fzi_sim_directive() :
{
 Token type = null, name = null;

 int min = 0, max = 0, id_type = 0;
}
{
  <FZI_SIM_PRAGMA>
  (
    (
      type = <FZI_SIM_PRAGMA_ITER_TYPE>  { id_type = 0; } min = constant_int() max = constant_int()
    )
   |
    (
      type = <FZI_SIM_PRAGMA_SIGNAL_TYPE>  {  id_type = 1; } name = getID() 
    )

  )
  {
    jjtThis.setName(type.image);
    jjtThis.setTypeId(id_type);

    if (id_type == 0) {
      jjtThis.setMinValue(min);
      jjtThis.setMaxValue(max);
    }
    else
    if (id_type == 1) {
      jjtThis.setSignalName(name.image);
    }
  }
  
}


void sc_main_declaration() :
{Token t;}
{

  <INT> { addDeclaration_specifiers("int", 0, false); } 
    t = <SC_MAIN>
    {
      ASTfunction_declarator fd = new ASTfunction_declarator(null, JJTFUNCTION_DECLARATOR);
      jjtree.openNodeScope(fd);



        ASTqualified_id qual_id = new ASTqualified_id(null, JJTQUALIFIED_ID);
        jjtree.openNodeScope(qual_id);

        qual_id.setName(t.image);

        jjtree.closeNodeScope(qual_id, true);
      
      
    }
    pl() parameter_list() pr()
    { jjtree.closeNodeScope(fd, true); }
       (
     "{"

       { sym.OpenScope(null, false); m_isSC_main = true; }

       (

//          LOOKAHEAD(sc_function_in_sc_main() postfix_expression_helper_main())
         LOOKAHEAD(3)
          (sc_function_in_sc_main() [ LOOKAHEAD(2) ";"]) #block_statement
         |
          LOOKAHEAD(statement())
            statement()

       )*

       { sym.CloseScope(); }

     "}"

     { m_isSC_main = false; }

     ) #block

}


void sc_spawn_routine_wrap() #systemCRoutine :
{Token t = null;}
{
  t = sc_spawn_routine()
  {jjtThis.setName(t.image);}
}
void dyn_process_creation_block_declaration() :
{}
{
  <SC_FORK_MACRO>
    sc_spawn_routine_wrap()  (LOOKAHEAD(3) <COMMA> sc_spawn_routine_wrap() )*
    [<COMMA>]

  <SC_JOIN_MACRO>
}

Token sc_spawn_routine() #void:
{Token t = null;}
{
  (
    t = <SC_SPAWN_ROUTINE> expr_list()
  )   
   
    { //jjtThis.setName(t.image);
      return t;

    }
}


void class_body(String class_name) #void:
{}
{
   (
     LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
      {
        if (m_isCTOR_look) {

          ASTmember_declaration m_d = new ASTmember_declaration(null, JJTMEMBER_DECLARATION);
          jjtree.openNodeScope(m_d);

          if (m_hasProcessMacroElab != 0)
            addHasProcessInstruction(class_name);

          jjtree.closeNodeScope(m_d, true);
        }
      }
      member_declaration(class_name)
     |
      // trick
      member_declaration(class_name)
   )*
}

void port_specifier_helper()  #void:
{}
{
   [namespace_name() <SCOPE>] sc_port_specifier()
}

void sc_port_specifier()  :
{ Token t = null; int numberOfChanels = 1; int size;
  boolean replace = false;
  String name = null;
  String s = null;
}
{
   [ LOOKAHEAD(scope_override_lookahead()) name = scope_override()  ]
   /* it should be declaration_specifiers() instead !builtin_type_specifier() !!!!!!!!!!!!!!!!!! */

   (
    
    (
     (
        t = <SC_IN>
       |
        t = <SC_OUT>
       |
        t = <SC_INOUT>
     )
     "<" declaration_specifiers_with_declarator() ">"
    )

   |


    (
        t = <SC_IN_CLK>
         {
          replace = true;
          s = SC_IN_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

          
         }     
       |
        t = <SC_OUT_CLK>
         {
          replace = true;
          s = SC_OUT_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

         }
        
       |
        t = <SC_INOUT_CLK>
         {
          replace = true;
          s = SC_INOUT_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

         }
        
    )
   |

    (
        t = <SC_IN_RESOLVED>
       |
        t = <SC_OUT_RESOLVED>
       |

        t = <SC_INOUT_RESOLVED>
    )
   |

    ( (
        t = <SC_FIFO_IN> 
       |
        t = <SC_FIFO_OUT>
      )
      { numberOfChanels = 0; }

      "<" declaration_specifiers_with_declarator() ">"
    )
   |
   // master / slave ports

    (
     (
       (
           t = <SC_INMASTER>
          |
           t = <SC_OUTMASTER>
          |
           t = <SC_INOUTMASTER>
          |
           t = <SC_INSLAVE>
          |
           t = <SC_OUTSLAVE>
          |
           t = <SC_INOUTSLAVE>
       )

       "<" [ declaration_specifiers_with_declarator() ]

           <COMMA>

           m_s_protocol_declaration()
       ">"

      )


     |

      (  (
           t = <SC_MASTER>
          |
           t = <SC_SLAVE>
         )
         "<" [ declaration_specifiers_with_declarator() ] ">"
      )

    )

   |

    (
      (
          t = <SC_IN_RV>
         |
          t = <SC_OUT_RV>
         |
          t = <SC_INOUT_RV>
      )

      "<" size = constant_int() ">"
      {
        jjtThis.setLength(size);
      }
    )
   |
    (
        t = <SC_PORT> "<" sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"

    )
  |
    (
        t = <TLM_INITIATOR_SOCKET>  "<" ( size = constant_int() )? <COMMA> sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"
    )
  | 
    (
        t = <TLM_TARGET_SOCKET>  "<" ( size = constant_int() )? <COMMA> sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"
    )
   )

   //qualified_id() ("," qualified_id())*

    {
      if (replace)

        jjtThis.setName(s);

      else
        jjtThis.setName(t.image);

      jjtThis.setNumberOfChanels(numberOfChanels);
    }


}

//void export_declaration() :
//{Token t;}
//{
//     (
//        t = <SC_EXPORT>
//     )
//
//     "<" declaration_specifiers_with_declarator() ">"
//
//     qualified_id() ("," qualified_id())*
//
//     {
//       jjtThis.setName(t.image);
//
//}    }

void m_s_protocol_declaration() :

{Token t2 = null; int size = 0; }
{


  (

    (
      (
        t2 = <SC_NOHANDSHAKE>
       |
        t2 = <SC_ENABLEHANDSHAKE>
       |
        t2 = <SC_FULLHANDSHAKE>
      )

      {jjtThis.setProtocol(MASTER_BUS_PROTOCOL_BUS_TYPE_CONST);}

      "<" declaration_specifiers_with_declarator() ">"

    )

   |
    (
      t2 = <SC_INDEXED> { jjtThis.setProtocol(MASTER_BUS_PROTOCOL_INDEXED_TYPE_CONST); }

      "<" size = constant_int()

          { jjtThis.setRange(size); }

      ">"

    )
  )
  {
    jjtThis.setName(t2.image);
  }
}



void sc_interface() #void:
{}
{   /* it should be declaration_specifiers() instead declaration_specifiers() !!!!!!!!!!!!!!!!!!! */
   declaration_specifiers_with_declarator()
}



void c_built_inTypes(SCPortTypes jjt) #void :
{ boolean isSignedChar = false;}

{
  <VOID>  { jjt.setName("void"); m_isCBuiltInType = true;}

  |
  <BOOL> {
   jjt.setName("bool");
   m_isCBuiltInType = true;
  }
  |
   LOOKAHEAD(2) (<SIGNED> {isSignedChar = true;} )? <CHAR>
    {
//      jjt.setLength(CHAR_SIZE_IN_BITS);
      if (isSignedChar)
        jjt.setName("signed char");
      else 
        jjt.setName("char");

      m_isCBuiltInType = true;
    }

  |
   LOOKAHEAD(2) <UNSIGNED> <CHAR>
    {
//      jjt.setLength(CHAR_SIZE_IN_BITS);
      jjt.setName("unsigned char");
      m_isCBuiltInType = true;

    }

  |
   LOOKAHEAD(2) (<SIGNED>)? <SHORT>
    {
      jjt.setName("short");
      m_isCBuiltInType = true;
//      jjt.setLength(SHORT_SIZE_IN_BITS);
    }

  |
   LOOKAHEAD(2) <UNSIGNED> <SHORT>
    {
      jjt.setName("unsigned short");
      m_isCBuiltInType = true;
//      jjt.setLength(SHORT_SIZE_IN_BITS);
    }

  |
   LOOKAHEAD(2) (<SIGNED>)? <LONG>
    {
      jjt.setName("long");
      m_isCBuiltInType = true;
//      jjt.setLength(LONG_SIZE_IN_BITS);
    }

  |
   LOOKAHEAD(3) <UNSIGNED> <LONG>
    {
      jjt.setName("unsigned long");
      m_isCBuiltInType = true;
//      jjt.setLength(LONG_SIZE_IN_BITS);
    }

  |
   LOOKAHEAD(2) (<SIGNED>)? <INT>
    {
//      jjt.setLength(INT_SIZE_IN_BITS);
      jjt.setName("int");
      m_isCBuiltInType = true;
    }
 |
   LOOKAHEAD(2) <SIGNED>
    {
//      jjt.setLength(INT_SIZE_IN_BITS);
      jjt.setName("int");
      m_isCBuiltInType = true;
    }

  |
   LOOKAHEAD(2) (<UNSIGNED>)? <INT>
    {

//      jjt.setLength(INT_SIZE_IN_BITS);
      jjt.setName("unsigned int");
      m_isCBuiltInType = true;

    }

  |
   LOOKAHEAD(2) <UNSIGNED>
    {
      jjt.setName("unsigned int");
//      jjt.setLength(INT_SIZE_IN_BITS);
      m_isCBuiltInType = true;
    }


  |

   <FLOAT>
     {
//      jjt.setLength(FLOAT_SIZE_IN_BITS);
      jjt.setName("float");
      m_isCBuiltInType = true;
     }
  |

   <UINT64>
     {
//      jjt.setLength(INT_SIZE_IN_BITS);
      jjt.setName("uint64");
      m_isCBuiltInType = true;
     }
  |
   <DOUBLE>
     {



       jjt.setName("double");
       m_isCBuiltInType = true;
//       jjt.setLength(DOUBLE_SIZE_IN_BITS);
     }

}

Token systemCTypes(SCPortTypes jjt) #void:
{Token t = null;

 int size = 1;
}
{
  (
   t = <SC_BIT>  {
               jjt.setLength(0);
            }
  |
   t = <SC_INT> "<" size = constant_int() ">"
            {
               if (size > MAX_FIXED_PRECISION_INTEGER ) {
                 throw new IndexOutOfBoundsException("Size " + size + " is out of range [1.." + MAX_FIXED_PRECISION_INTEGER + "]" );
               }
               jjt.setLength(size);
            }
  |
   t = <SC_UINT> "<" size = constant_int() ">"
            {
               if (size > MAX_FIXED_PRECISION_INTEGER ) {
                 throw new IndexOutOfBoundsException("Size " + size + " is out of range [1.." + MAX_FIXED_PRECISION_INTEGER + "]" );
               }
               jjt.setLength(size);
            }
  |
   t = <SC_BIGINT> "<" size = constant_int() ">"
            {
               if (size > MAX_NBITS) {
                 throw new IndexOutOfBoundsException("Size " + size + " is out of range [1.." + MAX_NBITS + "]" );
               }
               jjt.setLength(size);
            }
  |
   t = <SC_BIGUINT> "<" size = constant_int() ">"
            {

               if (size > MAX_NBITS) {
                 throw new IndexOutOfBoundsException("Size " + size + " is out of range [1.." + MAX_NBITS + "]" );
               }
               jjt.setLength(size);
            }
  |
   t = <SC_BIT_VECTOR> "<" size = constant_int() ">"
      {

         jjt.setLength(size);
      }
  |
   t = <SC_LOGIC_VECTOR> "<" size = constant_int() ">"
      {
         jjt.setLength(size);
      }
  |
   t = <SC_LOGIC>
      {
         jjt.setLength(0);
      }
  |
   t = <SC_FIXED>
      fixed_type_parse(jjt)

  |
   t = <SC_UFIXED>
      fixed_type_parse(jjt)
  |
   t = <SC_FIX>

  |
   t = <SC_UFIX>
  |
   t = <SC_FXNUM>
  |
   t = <SC_FIXED_FAST>
      fixed_type_parse(jjt)
      {
        jjt.setLength(FIXED_FAST_BIT_SIZE);

      }
  |

   t = <SC_UFIXED_FAST>
      fixed_type_parse(jjt)
      {

        jjt.setLength(FIXED_FAST_BIT_SIZE);
      }
  |
   t = <SC_FIX_FAST>
    {
      jjt.setLength(FIXED_FAST_BIT_SIZE);
    }
  |

   t = <SC_UFIX_FAST>
    {
      jjt.setLength(FIXED_FAST_BIT_SIZE);
    }
  |
   t = <SC_FXNUM_FAST>
    {
      jjt.setLength(FIXED_FAST_BIT_SIZE);
    }
  |
   t = <SC_FMT>
  |
   t = <SC_FXNUM_FAST_BITREF>
  |
   t = <SC_FXNUM_SUBREF>
  |
   t = <SC_FXNUM_FAST_SUBREF>

   
  |
   t = <SC_NUMREP>
  |
   t = <SC_FXTYPE_PARAMS>
  |
   t = <SC_FXTYPE_CONTEXT>
  |
   t = <SC_FXCAST_CONTEXT>
  |
   t = <SC_FXCAST_SWITCH>
  |
   t = <SC_FXNUM_BITREF> 
  |
   t = <SC_SIGNAL>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_BUFFER>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_IN_IF>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_OUT_IF>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_NB_IN_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_B_IN_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_NB_OUT_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_FIFO_B_OUT_IF> "<" declaration_specifiers_with_declarator() ">"         
  |
   t = <SC_CONTEXT>  "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_CONTEXT_BEGIN>

  |
   t = <SC_MODULE_NAME>
  |
   t = <SC_MODULE>
  |
   t = <SC_CHANNEL>

  |
   t = <SC_BEHAVIOR>
  |
   t = <SC_LOGIC_VECTOR_BASE>
  |
   t = <SC_SWITCH>
  |
   t = <SC_INTERFACE>
  |
   t = <SC_MUTEX_IF>
  |
   t = <SC_MUTEX>
  |
   t = <SC_SEMAPHORE_IF>

  |
   t = <SC_SEMAPHORE>
  |

   t = <SC_SIGNAL_IN_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_SIGNAL_OUT_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_SIGNAL_INOUT_IF> "<" declaration_specifiers_with_declarator() ">"
  |
   t = <SC_SIGNAL_RESOLVED>
  |
   t = <SC_SIGNAL_RV> "<" size = constant_int() ">"
   {
      jjt.setLength(size);

   }
