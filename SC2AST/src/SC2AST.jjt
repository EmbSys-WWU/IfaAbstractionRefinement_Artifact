void method_thread_fol_decl() #void :
{}
{
  (
    LOOKAHEAD(2) sc_sensitive_expr() (LOOKAHEAD(2) (dont_initialize() ))?
   |
    (dont_initialize() ) (LOOKAHEAD(2) sc_sensitive_expr())?
  )

//    sc_sensitive_dont_intit_expr()

}

void sc_sensitive_expr() #void :
{}
{
  (LOOKAHEAD(2) sc_sensitive() )+
}                             // | LOOKAHEAD(2) dont_initialize()


void sc_sensitive() :
{}
{
   LOOKAHEAD(2)
   (
     (
       <SENSITIVE> { jjtThis.setName("normal"); }
      |
       <SENSITIVE_POS> { jjtThis.setName("positive"); }
      |
       <SENSITIVE_NEG> { jjtThis.setName("negative"); }
     )
     (<SHIFTLEFT> (LOOKAHEAD(qualified_id() (<SHIFTLEFT> | ";") ) qualified_id() | postfix_expression() #postfix_expression(>1)  ) )+ ";"
   )
  |
(
     (
       <SENSITIVE> { jjtThis.setName("normal"); }
      |
       <SENSITIVE_POS> { jjtThis.setName("positive"); }
      |
       <SENSITIVE_NEG> { jjtThis.setName("negative"); }
     )
     pl() (LOOKAHEAD(qualified_id() pr() ) qualified_id() | postfix_expression() #postfix_expression(>1)) pr() ";"
   )
}

//     (
//       <SENSITIVE> { jjtThis.setName("normal"); }
//      |
