void sc_slave()  :
{Token t, t2;}
{
    <SC_SLAVE_MACRO> "(" t =  getID() <COMMA>  t2 = getID() ")"
      {
        jjtThis.setSlaveMethod(t.image);

        jjtThis.setSlavePort(t2.image);
        m_isExtOfSCClass = true;
      }
}

void dont_initialize() #systemCRoutine :
{Token t;}
{

  t = <DONT_INITIALIZE> expr_list() ";" {jjtThis.setName(t.image);}
}


void sc_method()  :
{Token t;}
{
    <SC_METHOD> "(" t =  getID() ")" {jjtThis.setName(t.image); m_isExtOfSCClass = true; }
}


void sc_thread()  :
{Token t;}
{
    <SC_THREAD> "(" t = getID() ")" {jjtThis.setName(t.image);  m_isExtOfSCClass = true; }

}

void sc_report_macro() :
{Token t;}
{
  (
    t = <SC_REPORT_INFO_MACRO>
   |
    t = <SC_REPORT_WARNING_MACRO>
   |
    t = <SC_REPORT_ERROR_MACRO>
   |
    t = <SC_REPORT_FATAL_MACRO>
  )

  {
    jjtThis.setName(t.image);
  }
  pl()
  (expression_list())?
  pr()
}

void sc_cthread() :
{
  String s1;
  String s2;
  String s3 = "pos"; // default value
}
{
   <SC_CTHREAD>  "(" s1 = clocked_thread() "," s2 = clock() (( "." | "->" ) s3 = edge() "("")")? ")"
   {
      jjtThis.setName(s1);
      jjtThis.setClock(s2);
      jjtThis.setEdge(s3);
      m_isExtOfSCClass = true;
   }
}

String clocked_thread() #void:

{
  Token t;
}
{
  t = getID()
  { return t.image;}

}


String clock() #void:
{
  Token t1;
}
{
  t1 = getID()
  { return t1.image ; }

}

String edge() #void:
{
  Token t1;
}
{
  t1 = getID()
  { return t1.image ; }

}



