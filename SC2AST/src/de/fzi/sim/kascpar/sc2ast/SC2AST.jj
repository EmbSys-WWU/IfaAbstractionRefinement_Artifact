void class_body(String class_name)      :
{}
{
   (
     LOOKAHEAD(dtor_ctor_decl_spec() ctor_declarator_lookahead())
      {
        if (m_isCTOR_look) {

          ASTmember_declaration m_d = new ASTmember_declaration(null, JJTMEMBER_DECLARATION);
          jjtree.openNodeScope(m_d);

          if (m_hasProcessMacroElab != 0)
            addHasProcessInstruction(class_name);

          jjtree.closeNodeScope(m_d, true);
        }
      }
      member_declaration(class_name)
     |
      // trick
      member_declaration(class_name)
   )*
}

