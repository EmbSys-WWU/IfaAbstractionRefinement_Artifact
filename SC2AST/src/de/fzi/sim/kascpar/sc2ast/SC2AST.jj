}

void sc_port_specifier()  :
{/*@bgen(jjtree) sc_port_specifier */
  ASTsc_port_specifier jjtn000 = new ASTsc_port_specifier(null, JJTSC_PORT_SPECIFIER);
  boolean jjtc000 = true;
  jjtree.openNodeScope(jjtn000);
/*@egen*/ Token t = null; int numberOfChanels = 1; int size;
  boolean replace = false;
  String name = null;
  String s = null;
}
{/*@bgen(jjtree) sc_port_specifier */
   try {
/*@egen*/
   [ LOOKAHEAD(scope_override_lookahead()) name = scope_override()  ]
   /* it should be declaration_specifiers() instead !builtin_type_specifier() !!!!!!!!!!!!!!!!!! */

   (
    
    (
     (
        t = <SC_IN>
       |
        t = <SC_OUT>
       |
        t = <SC_INOUT>
     )
     "<" declaration_specifiers_with_declarator() ">"
    )

   |


    (
        t = <SC_IN_CLK>
         {
          replace = true;
          s = SC_IN_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

          
         }     
       |
        t = <SC_OUT_CLK>
         {
          replace = true;
          s = SC_OUT_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

         }
        
       |
        t = <SC_INOUT_CLK>
         {
          replace = true;
          s = SC_INOUT_CONST;
          addDeclaration_specifiers(BOOL_CONST, 0, false);

         }
        
    )
   |

    (
        t = <SC_IN_RESOLVED>
       |
        t = <SC_OUT_RESOLVED>
       |

        t = <SC_INOUT_RESOLVED>
    )
   |

    ( (
        t = <SC_FIFO_IN> 
       |
        t = <SC_FIFO_OUT>
      )
      { numberOfChanels = 0; }

      "<" declaration_specifiers_with_declarator() ">"
    )
   |
   // master / slave ports

    (
     (
       (
           t = <SC_INMASTER>
          |
           t = <SC_OUTMASTER>
          |
           t = <SC_INOUTMASTER>
          |
           t = <SC_INSLAVE>
          |
           t = <SC_OUTSLAVE>
          |
           t = <SC_INOUTSLAVE>
       )

       "<" [ declaration_specifiers_with_declarator() ]

           <COMMA>

           m_s_protocol_declaration()
       ">"

      )


     |

      (  (
           t = <SC_MASTER>
          |
           t = <SC_SLAVE>
         )
         "<" [ declaration_specifiers_with_declarator() ] ">"
      )

    )

   |

    (
      (
          t = <SC_IN_RV>
         |
          t = <SC_OUT_RV>
         |
          t = <SC_INOUT_RV>
      )

      "<" size = constant_int() ">"
      {
        jjtn000.setLength(size);
      }
    )
   |
    (
        t = <SC_PORT> "<" sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"

    )
  |
    (
        t = <TLM_INITIATOR_SOCKET>  "<" ( size = constant_int() )? <COMMA> sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"
    )
  | 
    (
        t = <TLM_TARGET_SOCKET>  "<" ( size = constant_int() )? <COMMA> sc_interface() (<COMMA> numberOfChanels = constant_int() )? ">"
    )
   )/*@bgen(jjtree)*/
    {
      jjtree.closeNodeScope(jjtn000, true);
      jjtc000 = false;
    }
/*@egen*/

   //qualified_id() ("," qualified_id())*

    {
      if (replace)

        jjtn000.setName(s);

      else
        jjtn000.setName(t.image);

      jjtn000.setNumberOfChanels(numberOfChanels);
    }/*@bgen(jjtree)*/
   } catch (Throwable jjte000) {
     if (jjtc000) {
       jjtree.clearNodeScope(jjtn000);
       jjtc000 = false;
     } else {
       jjtree.popNode();
     }
     if (jjte000 instanceof RuntimeException) {
       throw (RuntimeException)jjte000;
     }
     if (jjte000 instanceof ParseException) {
       throw (ParseException)jjte000;
     }
     throw (Error)jjte000;
   } finally {
     if (jjtc000) {
       jjtree.closeNodeScope(jjtn000, true);
     }
   }
/*@egen*/


}

