 boolean jjtc000 = true;
 jjtree.openNodeScope(jjtn000);
/*@egen*/Token t; }
{/*@bgen(jjtree) preprocessor_directive */
   try {
/*@egen*/
   t = <PREPROCESSOR_OUTPUT> {
//    System.out.println(t.image);
//
//    System.out.println(getToken(1).image);
//    System.out.println(getToken(2).image);
//    System.out.println(getToken(3).image);
//    System.out.println(getToken(4).image);
      jjtn000.setName(t.image);


     while(getToken(1).image.equals("\\")){
       // shifts token pointer forward
       getNextToken();
       // skips all "\\" tokens
       while(getToken(1).image.equals("\\"))
        getNextToken();

       jjtn000.setName(jjtn000.name() + getToken(1).image);
       // shifts token pointer forward
       getNextToken();
     }
   }
   ("\\")?/*@bgen(jjtree)*/
   } finally {
