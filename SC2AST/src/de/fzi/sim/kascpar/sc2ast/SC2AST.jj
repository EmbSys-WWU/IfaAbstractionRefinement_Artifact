String report_handler_scope()       :
{Token t; String name;}
{
  (t = <SC_REPORT_HANDLER> <SCOPE> name = report_handler_method() )
  { return t.image + "::" + name; }
  
}

String report_handler_method()      :
{Token t;}
{
  t = <SC_REPORT_HANDLER_METHODS> expr_list()
  { return t.image; }

}

void fixed_type_parse(SCPortTypes jjt)       :
{
  int size, size2, size3 = 0;
  Token t3 = null, t4 = null;

}
{
  "<" size = constant_int()
  <COMMA> size2 = constant_int()
  (LOOKAHEAD(2) <COMMA> t3  = <FIXED_POINT_QUANTIZATION_TYPE>)?
  (LOOKAHEAD(2) <COMMA> t4  = <FIXED_POINT_OVERFLOW_TYPE>)?
  (<COMMA> size3  = constant_int())?
  ">"
  {

    jjt.setTotalWordLength(size);
    jjt.setIntegerWordLength(size2);

    if (t3 != null)
      jjt.setQuantizationMode(t3.image);

    if (t4 != null)
      jjt.setOverflowMode(t4.image);

    if (size3 != 0)
      jjt.setNumberOfSaturatedBits(size3);

    jjt.setSystemCDataType(true);
  }

}

Token sc_wait_until_statement()       :
{
Token t;
}

{
  t = <SC_WAIT_UNTIL_ROUTINE> sc_wait_watching_statement()
  { return t;}

}


void sc_wait_watching_statement()       :

