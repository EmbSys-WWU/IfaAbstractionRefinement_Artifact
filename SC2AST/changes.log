########

new tokens:

< | < UINT64 : "uint64" >
< | <TLM_SYNC_ENUM : "tlm_sync_enum">
< | <TLM_INITIATOR_SOCKET : "tlm_initiator_socket">
< | <TLM_TARGET_SOCKET : "tlm_target_socket">
< | <PEQ_WITH_CB_AND_PHASE : "peq_with_cb_and_phase">
< | <TLM_DMI : "tlm_dmi">
< 

in c_built_inTypes(SCPortTypes jjt) :
<    <UINT64>
<      {
<       jjt.setName("uint64");
<       m_isCBuiltInType = true;
<      }
<   |

in systemCTypes(SCPortTypes jjt) :
>  int size;
<  int size = 1;
(new jjtree version doesn't like uninitialized variables)

<   |  
<    t = <TLM_SYNC_ENUM>
<   |
