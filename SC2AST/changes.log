<      {
<          jjt.setLength(size);
<       }
<    t = <TLM_TARGET_SOCKET>  "<" ( size = constant_int() )? <COMMA> declaration_specifiers_with_declarator()  <COMMA> ( constant_int() )? ">"
<     {
<          jjt.setLength(size);
<       }
<   |
<    t = <PEQ_WITH_CB_AND_PHASE> "<" declaration_specifiers_with_declarator() <COMMA> declaration_specifiers_with_declarator() ">"

in systemCKeyWords() :
<   |   
<    t = <TLM_SYNC_ENUM>
<   |
