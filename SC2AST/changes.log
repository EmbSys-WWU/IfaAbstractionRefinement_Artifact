Changes for allowing namespaces of declarations and functions:

in declaration_specifiers() :
<    String name = null;
<    [ LOOKAHEAD(scope_override_lookahead()) name = scope_override()  ]


in sc_port_specifiers() :
<    String name = null;
<    [ LOOKAHEAD(scope_override_lookahead()) name = scope_override()  ]

